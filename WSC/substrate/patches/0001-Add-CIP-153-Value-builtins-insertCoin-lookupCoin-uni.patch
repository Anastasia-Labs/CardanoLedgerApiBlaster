diff --git a/PlutusCore/Value/Basic.lean b/PlutusCore/Value/Basic.lean
new file mode 100644
index 0000000..0b1da38
--- /dev/null
+++ b/PlutusCore/Value/Basic.lean
@@ -0,0 +1,256 @@
+import PlutusCore.ByteString
+import PlutusCore.Integer
+import PlutusCore.Data
+
+namespace PlutusCore.Value
+
+open PlutusCore.ByteString (ByteString)
+open PlutusCore.Integer (Integer)
+open PlutusCore.Data (Data)
+
+/-! ## Formalisation of the CIP-153 builtin `Value` (plutus-core `PlutusCore.Value`).
+
+The Haskell implementation is a nested strict map
+`Map K (Map K Quantity)` (currency symbol → token name → quantity) with the
+invariants: no empty inner map and no zero quantity (`Value.hs`, "Invariants"
+comment on the `Value` data declaration). We model it as the ordered
+association list produced by `PlutusCore.Value.toList`:
+
+  `ValueRep := List (ByteString × List (ByteString × Integer))`
+
+with keys strictly ascending at both levels, no zero quantity and no empty
+inner list. All operations below are line-by-line models of
+`plutus/plutus-core/plutus-core/src/PlutusCore/Value.hs`; `Option.none`
+models `BuiltinResult` failure (`fail`). -/
+
+/-- Association-list representation of a normalized builtin `Value`. -/
+abbrev ValueRep := List (ByteString × List (ByteString × Integer))
+
+/-- Max length (in bytes) for currency symbols and token names
+    (`Value.hs` `maxKeyLen = 32`). -/
+def maxKeyLen : Nat := 32
+
+/-- `Value.hs` smart constructor `k`: keys must be ≤ 32 bytes. -/
+def validKey (b : ByteString) : Bool := b.length ≤ maxKeyLen
+
+/-- Lower bound of `Quantity`: `-(2^127)` (`Value.hs` `instance Bounded Quantity`). -/
+def quantityMinBound : Integer := -(2 ^ (127 : Nat))
+
+/-- Upper bound of `Quantity`: `2^127 - 1` (`Value.hs` `instance Bounded Quantity`). -/
+def quantityMaxBound : Integer := 2 ^ (127 : Nat) - 1
+
+/-- `Value.hs` smart constructor `quantity`: signed 128-bit bounds check. -/
+def validQuantity (i : Integer) : Bool :=
+  quantityMinBound ≤ i && i ≤ quantityMaxBound
+
+/-- Total size: number of distinct (currency, token) pairs
+    (`Value.hs` `totalSize`). -/
+def totalSize (v : ValueRep) : Nat :=
+  v.foldl (fun acc (_, inner) => acc + inner.length) 0
+
+/-- Size of the largest inner map (`Value.hs` `maxInnerSize`). -/
+def maxInnerSize (v : ValueRep) : Nat :=
+  v.foldl (fun acc (_, inner) => max acc inner.length) 0
+
+/-- Whether any quantity is negative (models `Value.hs` `negativeAmounts v > 0`;
+    the Haskell code caches the count, we recompute). -/
+def hasNegativeAmount (v : ValueRep) : Bool :=
+  v.any (fun (_, inner) => inner.any (fun (_, q) => q < 0))
+
+/-- Ordered insert into an inner list, replacing the quantity when the token
+    already exists (models `Map.insertLookupWithKey (\_ _ _ -> qty)` in
+    `Value.hs` `insertCoin`: the new quantity wins). -/
+def innerInsert (tok : ByteString) (q : Integer) :
+    List (ByteString × Integer) → List (ByteString × Integer)
+  | [] => [(tok, q)]
+  | (t, q') :: rest =>
+      if tok < t then (tok, q) :: (t, q') :: rest
+      else if tok == t then (tok, q) :: rest
+      else (t, q') :: innerInsert tok q rest
+
+/-- Ordered insert into the outer list, replacing the whole inner list when the
+    currency already exists (models `Map.insert` / `Map.fromList` last-wins). -/
+def outerInsertReplace (cur : ByteString) (inner : List (ByteString × Integer)) :
+    ValueRep → ValueRep
+  | [] => [(cur, inner)]
+  | (c, i) :: rest =>
+      if cur < c then (cur, inner) :: (c, i) :: rest
+      else if cur == c then (cur, inner) :: rest
+      else (c, i) :: outerInsertReplace cur inner rest
+
+/-- `Value.hs` `deleteCoin`: remove the (currency, token) entry if present,
+    dropping the inner map when it becomes empty. NOTE: `deleteCoin` performs
+    no key-length validation (it uses the unchecked `UnsafeK`). -/
+def deleteCoin (cur tok : ByteString) : ValueRep → ValueRep
+  | [] => []
+  | (c, inner) :: rest =>
+      if c == cur then
+        let inner' := inner.filter (fun (t, _) => t != tok)
+        if inner'.isEmpty then rest else (c, inner') :: rest
+      else (c, inner) :: deleteCoin cur tok rest
+
+/-- `Value.hs` `insertCoin`:
+    * amount 0 deletes the entry (no validation of keys or amount);
+    * otherwise the currency and token must be ≤ 32 bytes and the amount
+      within signed 128-bit bounds (else `fail`, modeled as `none`);
+    * an existing quantity is replaced by the new one. -/
+def insertCoin (cur tok : ByteString) (amt : Integer) (v : ValueRep) :
+    Option ValueRep :=
+  if amt == 0 then some (deleteCoin cur tok v)
+  else if ¬ validKey cur then none
+  else if ¬ validKey tok then none
+  else if ¬ validQuantity amt then none
+  else some (go v)
+  where
+    /-- ordered insert of a single coin (inner insert on key hit). -/
+    go : ValueRep → ValueRep
+      | [] => [(cur, [(tok, amt)])]
+      | (c, inner) :: rest =>
+          if cur < c then (cur, [(tok, amt)]) :: (c, inner) :: rest
+          else if cur == c then (c, innerInsert tok amt inner) :: rest
+          else (c, inner) :: go rest
+
+/-- `Value.hs` `lookupCoin`: 0 when absent; no key validation (`UnsafeK`). -/
+def lookupCoin (cur tok : ByteString) (v : ValueRep) : Integer :=
+  match v.find? (fun (c, _) => c == cur) with
+  | none => 0
+  | some (_, inner) =>
+      match inner.find? (fun (t, _) => t == tok) with
+      | none => 0
+      | some (_, q) => q
+
+/-- Merge two sorted inner lists, adding quantities on key collision.
+    Overflow of the signed 128-bit bounds is an error (`none`); an exact-zero
+    sum drops the entry (models the innermost `M.zipWithMaybeAMatched` in
+    `Value.hs` `unionValue`). -/
+def unionInner :
+    List (ByteString × Integer) → List (ByteString × Integer) →
+    Option (List (ByteString × Integer))
+  | [], ys => some ys
+  | x :: xs, [] => some (x :: xs)
+  | (t₁, q₁) :: xs, (t₂, q₂) :: ys =>
+      if t₁ < t₂ then
+        (unionInner xs ((t₂, q₂) :: ys)).map ((t₁, q₁) :: ·)
+      else if t₂ < t₁ then
+        (unionInner ((t₁, q₁) :: xs) ys).map ((t₂, q₂) :: ·)
+      else
+        let s := q₁ + q₂
+        if validQuantity s then
+          (unionInner xs ys).map
+            (fun rest => if s == 0 then rest else (t₁, s) :: rest)
+        else none
+  termination_by xs ys => xs.length + ys.length
+
+/-- Merge two sorted outer lists (inner lists merged with `unionInner`);
+    an inner merge that comes back empty is dropped (models the outer
+    `M.zipWithMaybeAMatched` returning `Nothing` for a null inner map). -/
+def unionOuter : ValueRep → ValueRep → Option ValueRep
+  | [], ys => some ys
+  | x :: xs, [] => some (x :: xs)
+  | (c₁, i₁) :: xs, (c₂, i₂) :: ys =>
+      if c₁ < c₂ then
+        (unionOuter xs ((c₂, i₂) :: ys)).map ((c₁, i₁) :: ·)
+      else if c₂ < c₁ then
+        (unionOuter ((c₁, i₁) :: xs) ys).map ((c₂, i₂) :: ·)
+      else do
+        let inner ← unionInner i₁ i₂
+        let rest ← unionOuter xs ys
+        pure (if inner.isEmpty then rest else (c₁, inner) :: rest)
+  termination_by xs ys => xs.length + ys.length
+
+/-- `Value.hs` `unionValue`: pointwise addition; errors (`none`) if any sum
+    leaves the signed 128-bit bounds, drops exact-zero sums and empty inner
+    maps. (The Haskell empty-value short circuits and the argument swap on
+    sizes are performance-only: `unionValue` is commutative and `unionOuter`
+    already returns the other argument unchanged against `[]`.) -/
+def unionValue (v₁ v₂ : ValueRep) : Option ValueRep := unionOuter v₁ v₂
+
+/-- `Value.hs` `valueContains`: errors (`none`) when either argument contains
+    a negative amount; otherwise `v₁` contains `v₂` iff every
+    (currency, token, quantity) of `v₂` satisfies
+    `lookupCoin currency token v₁ ≥ quantity`. (The `totalSize` comparison in
+    the Haskell code is a short-circuit, not a semantic difference: with both
+    values normalized and non-negative, `v₂` strictly bigger than `v₁` always
+    fails the pointwise check.) -/
+def valueContains (v₁ v₂ : ValueRep) : Option Bool :=
+  if hasNegativeAmount v₁ then none
+  else if hasNegativeAmount v₂ then none
+  else some (v₂.all fun (c, inner) =>
+    inner.all fun (t, q) => q ≤ lookupCoin c t v₁)
+
+/-- `Value.hs` `valueData`: encode as `Map [(B cur, Map [(B tok, I q)])]` in
+    ascending key order (our representation is already the ascending
+    `Map.toList` order). -/
+def valueData (v : ValueRep) : Data :=
+  .Map (v.map fun (c, inner) =>
+    (.B c, .Map (inner.map fun (t, q) => (.B t, .I q))))
+
+/-- Strictly-ascending check against an optional previous key. -/
+private def ascendingFrom (prev : Option ByteString) (key : ByteString) : Bool :=
+  match prev with
+  | none => true
+  | some p => decide (p < key)
+
+/-- Inner-map decoding for `unValueData` (`Value.hs` `goTokens`/`unB`/`unQ`):
+    every key must be a `B` of ≤ 32 bytes, token names strictly ascending,
+    every quantity an `I` that is non-zero and within signed 128-bit bounds. -/
+def unValueDataTokens :
+    Option ByteString → List (Data × Data) → Option (List (ByteString × Integer))
+  | _, [] => some []
+  | prev, (tD, qD) :: rest =>
+      match tD, qD with
+      | .B t, .I q =>
+          if ¬ validKey t then none
+          else if ¬ ascendingFrom prev t then none
+          else if q == 0 then none
+          else if ¬ validQuantity q then none
+          else ((t, q) :: ·) <$> unValueDataTokens (some t) rest
+      | _, _ => none
+
+/-- Outer-map decoding for `unValueData` (`Value.hs` `goCurrencies`):
+    currency symbols must be `B` of ≤ 32 bytes and strictly ascending; every
+    inner value must be a non-empty `Map` validated by `unValueDataTokens`. -/
+def unValueDataCurrencies :
+    Option ByteString → List (Data × Data) → Option ValueRep
+  | _, [] => some []
+  | prev, (cD, tsD) :: rest =>
+      match cD with
+      | .B c =>
+          if ¬ validKey c then none
+          else if ¬ ascendingFrom prev c then none
+          else
+            match tsD with
+            | .Map ts =>
+                if ts.isEmpty then none
+                else do
+                  let inner ← unValueDataTokens none ts
+                  let restV ← unValueDataCurrencies (some c) rest
+                  pure ((c, inner) :: restV)
+            | _ => none
+      | _ => none
+
+/-- `Value.hs` `unValueData`: the argument must be a `Map`; contents validated
+    by `unValueDataCurrencies`/`unValueDataTokens`. A valid encoding is already
+    normalized (strictly ascending keys, no zero quantity, no empty inner map),
+    so the result needs no further normalization. The empty outer map is
+    valid and decodes to the empty value. -/
+def unValueData : Data → Option ValueRep
+  | .Map cs => unValueDataCurrencies none cs
+  | _ => none
+
+/-- Normalization used when constructing a `Value` from unordered/duplicated
+    input (models `Map.fromList` last-wins at both levels followed by
+    `Value.hs` `pack`'s `normalize`: drop zero quantities, then empty inner
+    maps). Used by the flat constant decoder (`instance Flat Value` is
+    `pack <$> decode` over the nested-map flat encoding, which is a list of
+    key/value pairs). -/
+def packValue (raw : List (ByteString × List (ByteString × Integer))) : ValueRep :=
+  let outer := raw.foldl
+    (fun acc (c, innerRaw) =>
+      let inner := innerRaw.foldl (fun iacc (t, q) => innerInsert t q iacc) []
+      outerInsertReplace c inner acc)
+    []
+  (outer.map fun (c, inner) => (c, inner.filter (fun (_, q) => q != 0))).filter
+    (fun (_, inner) => ¬ inner.isEmpty)
+
+end PlutusCore.Value
diff --git a/PlutusCore/Value/Tests.lean b/PlutusCore/Value/Tests.lean
new file mode 100644
index 0000000..169cb49
--- /dev/null
+++ b/PlutusCore/Value/Tests.lean
@@ -0,0 +1,331 @@
+import PlutusCore.Value.Basic
+import PlutusCore.UPLC.BuiltinFunctions.Evaluate
+import PlutusCore.UPLC.CekMachine
+import PlutusCore.UPLC.ScriptEncoding.Basic
+
+/-! ## Tests for the CIP-153 builtin `Value` operations.
+
+Semantics under test are modeled on
+`plutus/plutus-core/plutus-core/src/PlutusCore/Value.hs`; each test cites the
+behaviour it pins down. -/
+
+namespace PlutusCore.Value.Tests
+
+open PlutusCore.ByteString (ByteString)
+open PlutusCore.Data (Data)
+open PlutusCore.Value
+open PlutusCore.UPLC.Term
+open PlutusCore.UPLC.CekValue
+open PlutusCore.UPLC.CekMachine
+open PlutusCore.UPLC.ExBudget
+open PlutusCore.UPLC.CostModels
+open PlutusCore.UPLC.PlutusScript
+open PlutusCore.UPLC.BuiltinFunctions.Evaluate
+open PlutusCore.Default
+
+private def bs : String → ByteString := ByteString.mk
+
+private def a : ByteString := bs "a"
+private def b : ByteString := bs "b"
+private def c : ByteString := bs "c"
+private def t1 : ByteString := bs "t1"
+private def t2 : ByteString := bs "t2"
+/-- A 33-byte key — one over `maxKeyLen`. -/
+private def tooLong : ByteString := bs (String.mk (List.replicate 33 'x'))
+
+-- ---------------------------------------------------------------------------
+-- insertCoin
+-- ---------------------------------------------------------------------------
+
+-- Insert into empty
+example : insertCoin a t1 5 [] == some [(a, [(t1, 5)])] := by native_decide
+
+-- Insert keeps both levels sorted
+example :
+    (do let v ← insertCoin b t2 2 []
+        let v ← insertCoin a t1 1 v
+        insertCoin a t2 3 v)
+      == some [(a, [(t1, 1), (t2, 3)]), (b, [(t2, 2)])] := by native_decide
+
+-- Existing quantity is replaced, not added (insertLookupWithKey \_ _ _ -> qty)
+example :
+    (insertCoin a t1 7 [(a, [(t1, 5)])]) == some [(a, [(t1, 7)])] := by
+  native_decide
+
+-- Amount 0 deletes the entry and drops the now-empty inner map
+example : insertCoin a t1 0 [(a, [(t1, 5)]), (b, [(t2, 2)])]
+    == some [(b, [(t2, 2)])] := by native_decide
+
+-- Amount 0 for an absent entry is a no-op (deleteCoin finds nothing)
+example : insertCoin a t2 0 [(a, [(t1, 5)])] == some [(a, [(t1, 5)])] := by
+  native_decide
+
+-- Amount 0 skips all validation (deleteCoin uses the unchecked UnsafeK)
+example : insertCoin tooLong tooLong 0 [(a, [(t1, 5)])]
+    == some [(a, [(t1, 5)])] := by native_decide
+
+-- Oversized currency key errors
+example : insertCoin tooLong t1 5 [] == none := by native_decide
+
+-- Oversized token key errors
+example : insertCoin a tooLong 5 [] == none := by native_decide
+
+-- Quantity out of signed 128-bit bounds errors (2^127 is one over maxBound)
+example : insertCoin a t1 (2 ^ (127 : Nat)) [] == none := by native_decide
+
+-- Boundary quantities are accepted
+example : (insertCoin a t1 quantityMaxBound []).isSome
+    && (insertCoin a t1 quantityMinBound []).isSome := by native_decide
+
+-- ---------------------------------------------------------------------------
+-- lookupCoin
+-- ---------------------------------------------------------------------------
+
+example : lookupCoin a t1 [(a, [(t1, 5), (t2, 3)])] == 5 := by native_decide
+example : lookupCoin a t2 [(a, [(t1, 5), (t2, 3)])] == 3 := by native_decide
+example : lookupCoin b t1 [(a, [(t1, 5)])] == 0 := by native_decide
+example : lookupCoin a t2 [(a, [(t1, 5)])] == 0 := by native_decide
+-- No key validation on lookup (UnsafeK): oversized key just misses
+example : lookupCoin tooLong t1 [(a, [(t1, 5)])] == 0 := by native_decide
+
+-- ---------------------------------------------------------------------------
+-- unionValue
+-- ---------------------------------------------------------------------------
+
+-- Disjoint currencies merge in order
+example : unionValue [(b, [(t1, 1)])] [(a, [(t1, 2)])]
+    == some [(a, [(t1, 2)]), (b, [(t1, 1)])] := by native_decide
+
+-- Colliding entries add quantities
+example : unionValue [(a, [(t1, 1), (t2, 2)])] [(a, [(t1, 10)]), (b, [(t1, 5)])]
+    == some [(a, [(t1, 11), (t2, 2)]), (b, [(t1, 5)])] := by native_decide
+
+-- An exact-zero sum drops the entry, and an inner map emptied by that drop
+-- disappears entirely
+example : unionValue [(a, [(t1, 5)])] [(a, [(t1, -5)])] == some [] := by
+  native_decide
+example : unionValue [(a, [(t1, 5), (t2, 1)])] [(a, [(t1, -5)])]
+    == some [(a, [(t2, 1)])] := by native_decide
+
+-- Sum overflowing the signed 128-bit bounds errors
+example : unionValue [(a, [(t1, quantityMaxBound)])] [(a, [(t1, 1)])] == none := by
+  native_decide
+example : unionValue [(a, [(t1, quantityMinBound)])] [(a, [(t1, -1)])] == none := by
+  native_decide
+
+-- Union against empty is the identity
+example : unionValue [] [(a, [(t1, 5)])] == some [(a, [(t1, 5)])] := by
+  native_decide
+example : unionValue [(a, [(t1, 5)])] [] == some [(a, [(t1, 5)])] := by
+  native_decide
+
+-- ---------------------------------------------------------------------------
+-- valueContains
+-- ---------------------------------------------------------------------------
+
+-- Pointwise containment (v1 ⊇ v2 with ≥ on quantities)
+example : valueContains [(a, [(t1, 5), (t2, 3)]), (b, [(t1, 1)])] [(a, [(t2, 2)])]
+    == some true := by native_decide
+
+-- Insufficient quantity
+example : valueContains [(a, [(t1, 1)])] [(a, [(t1, 2)])] == some false := by
+  native_decide
+
+-- Missing key
+example : valueContains [(a, [(t1, 5)])] [(b, [(t1, 1)])] == some false := by
+  native_decide
+
+-- The empty value is contained in anything (incl. itself)
+example : (valueContains [(a, [(t1, 5)])] [] == some true)
+    && (valueContains [] [] == some true) := by native_decide
+
+-- A negative amount in either argument is an error, in v1 …
+example : valueContains [(a, [(t1, -1)])] [(a, [(t1, 1)])] == none := by
+  native_decide
+-- … and in v2
+example : valueContains [(a, [(t1, 5)])] [(a, [(t1, -1)])] == none := by
+  native_decide
+
+-- ---------------------------------------------------------------------------
+-- valueData / unValueData
+-- ---------------------------------------------------------------------------
+
+example : valueData [(a, [(t1, 5)]), (b, [(t2, -2)])]
+    == Data.Map [(.B a, .Map [(.B t1, .I 5)]), (.B b, .Map [(.B t2, .I (-2))])] := by
+  native_decide
+
+example : valueData [] == Data.Map [] := by native_decide
+
+-- Round trip on a normalized value
+example :
+    unValueData (valueData [(a, [(t1, 5), (t2, 3)]), (b, [(t1, -1)])])
+      == some [(a, [(t1, 5), (t2, 3)]), (b, [(t1, -1)])] := by native_decide
+
+-- The empty outer map is a valid empty value
+example : unValueData (.Map []) == some [] := by native_decide
+
+-- Non-Map constructor rejected (outer and inner)
+example : unValueData (.I 0) == none := by native_decide
+example : unValueData (.Map [(.B a, .I 0)]) == none := by native_decide
+
+-- Empty inner map rejected
+example : unValueData (.Map [(.B a, .Map [])]) == none := by native_decide
+
+-- Currency symbols must be strictly ascending (duplicates also rejected)
+example : unValueData
+    (.Map [(.B b, .Map [(.B t1, .I 1)]), (.B a, .Map [(.B t1, .I 1)])])
+    == none := by native_decide
+example : unValueData
+    (.Map [(.B a, .Map [(.B t1, .I 1)]), (.B a, .Map [(.B t1, .I 1)])])
+    == none := by native_decide
+
+-- Token names must be strictly ascending within an inner map
+example : unValueData (.Map [(.B a, .Map [(.B t2, .I 1), (.B t1, .I 1)])])
+    == none := by native_decide
+
+-- Zero quantities rejected
+example : unValueData (.Map [(.B a, .Map [(.B t1, .I 0)])]) == none := by
+  native_decide
+
+-- Out-of-bounds quantities rejected
+example : unValueData (.Map [(.B a, .Map [(.B t1, .I (2 ^ (127 : Nat)))])])
+    == none := by native_decide
+
+-- Non-B keys rejected
+example : unValueData (.Map [(.I 1, .Map [(.B t1, .I 1)])]) == none := by
+  native_decide
+
+-- Oversized keys rejected
+example : unValueData (.Map [(.B tooLong, .Map [(.B t1, .I 1)])]) == none := by
+  native_decide
+
+-- ---------------------------------------------------------------------------
+-- packValue (flat constant decoding normalizer)
+-- ---------------------------------------------------------------------------
+
+-- Unsorted input is sorted; duplicate keys: last wins (Map.fromList);
+-- zero quantities and empty inner maps are dropped (pack/normalize)
+example : packValue [(b, [(t1, 1)]), (a, [(t2, 2), (t1, 3), (t2, 4)])]
+    == [(a, [(t1, 3), (t2, 4)]), (b, [(t1, 1)])] := by native_decide
+example : packValue [(a, [(t1, 0)]), (b, [(t1, 1)])] == [(b, [(t1, 1)])] := by
+  native_decide
+
+-- ---------------------------------------------------------------------------
+-- CEK dispatch (evaluateBuiltinFunction; args reversed on the stack)
+-- ---------------------------------------------------------------------------
+
+private def evalB (bf : BuiltinFun) (vs : List CekValue) : Option CekValue :=
+  evaluateBuiltinFunction default bf vs
+
+private def isConst (r : Option CekValue) (k : Const) : Bool :=
+  match r with
+  | some (.VCon k') => k' == k
+  | _ => false
+
+example : isConst
+    (evalB .InsertCoin
+      [.VCon (.Value []), .VCon (.Integer 5), .VCon (.ByteString t1),
+       .VCon (.ByteString a)])
+    (.Value [(a, [(t1, 5)])]) := by native_decide
+
+example : (evalB .InsertCoin
+    [.VCon (.Value []), .VCon (.Integer (2 ^ (127 : Nat))),
+     .VCon (.ByteString t1), .VCon (.ByteString a)]).isNone := by native_decide
+
+example : isConst
+    (evalB .LookupCoin
+      [.VCon (.Value [(a, [(t1, 5)])]), .VCon (.ByteString t1),
+       .VCon (.ByteString a)])
+    (.Integer 5) := by native_decide
+
+example : isConst
+    (evalB .UnionValue
+      [.VCon (.Value [(a, [(t1, -5)])]), .VCon (.Value [(a, [(t1, 5)])])])
+    (.Value []) := by native_decide
+
+-- valueContains: CEK args are [v2, v1]; v1 (the container) is applied first
+example : isConst
+    (evalB .ValueContains
+      [.VCon (.Value [(a, [(t1, 2)])]), .VCon (.Value [(a, [(t1, 5)])])])
+    (.Bool true) := by native_decide
+
+example : isConst
+    (evalB .ValueContains
+      [.VCon (.Value [(a, [(t1, 5)])]), .VCon (.Value [(a, [(t1, 2)])])])
+    (.Bool false) := by native_decide
+
+example : isConst
+    (evalB .ValueData [.VCon (.Value [(a, [(t1, 5)])])])
+    (.Data (.Map [(.B a, .Map [(.B t1, .I 5)])])) := by native_decide
+
+example : isConst
+    (evalB .UnValueData [.VCon (.Data (.Map [(.B a, .Map [(.B t1, .I 5)])]))])
+    (.Value [(a, [(t1, 5)])]) := by native_decide
+
+example : (evalB .UnValueData
+    [.VCon (.Data (.Map [(.B a, .Map [(.B t2, .I 1), (.B t1, .I 1)])]))]).isNone := by
+  native_decide
+
+-- Wrong argument types are a machine error (none), not a crash
+example : (evalB .UnionValue [.VCon (.Integer 1), .VCon (.Value [])]).isNone := by
+  native_decide
+
+-- ---------------------------------------------------------------------------
+-- KEY GATE: the compiled wsc-poc Programmable Logic Global validator
+-- (PV11 build with dropList + CIP-153 Value builtins, from wsc-poc branch
+-- feat/van-rossem-bump, generated/scripts/unapplied/prod) must decode.
+-- Before the CIP-153 flat tags (94-99) were enabled this file failed to
+-- decode.
+-- ---------------------------------------------------------------------------
+
+/--
+info: Successfully decoded double CBOR hex 'PlutusCore/UPLC/ScriptEncoding/TestsFlat/programmableLogicGlobal.flat'
+-/
+#guard_msgs in
+#import_uplc wstGlobal PlutusV3 double_cbor_hex "PlutusCore/UPLC/ScriptEncoding/TestsFlat/programmableLogicGlobal.flat"
+
+-- The decoded program has the expected UPLC version …
+example : (match wstGlobal.script with
+  | .Program (.Version 1 1 0) _ => true
+  | _ => false) = true := by native_decide
+
+-- … and actually uses the CIP-153 builtins (the gate is not vacuous)
+private partial def usesBuiltin (bf : BuiltinFun) : Term → Bool
+  | .Builtin bf' => bf' == bf
+  | .Lam _ t => usesBuiltin bf t
+  | .Delay t => usesBuiltin bf t
+  | .Force t => usesBuiltin bf t
+  | .Apply f x => usesBuiltin bf f || usesBuiltin bf x
+  | .Constr _ ts => ts.any (usesBuiltin bf)
+  | .Case s hs => usesBuiltin bf s || hs.any (usesBuiltin bf)
+  | _ => false
+
+private def globalBody : Term :=
+  match wstGlobal.script with
+  | .Program _ t => t
+
+example : usesBuiltin .UnValueData globalBody = true := by native_decide
+example : usesBuiltin .UnionValue globalBody = true := by native_decide
+example : usesBuiltin .ValueContains globalBody = true := by native_decide
+example : usesBuiltin .InsertCoin globalBody = true := by native_decide
+example : usesBuiltin .ValueData globalBody = true := by native_decide
+example : usesBuiltin .DropList globalBody = true := by native_decide
+
+-- Evaluation smoke: run the decoded validator against dummy arguments with a
+-- generous budget. The machine must terminate with an evaluation result
+-- (Success or EvaluationError — dummy args do eventually fail validation) and
+-- must not exhaust the budget or get stuck: this exercises decode → CEK on
+-- the real bytecode.
+private def smokeBudget : ExBudget := ⟨⟨10_000_000_000⟩, ⟨10_000_000_000⟩⟩
+
+private def smokeResult : EvaluationResult :=
+  runStepsWithBudget default defaultCekMachineCostsC
+    (initialState (applyParams globalBody
+      [.Const (.Data (.I 0)), .Const (.Data (.I 0))]))
+    smokeBudget smokeBudget
+
+example : (match smokeResult with
+  | .BudgetExhausted _ => false
+  | _ => true) = true := by native_decide
+
+end PlutusCore.Value.Tests
