+import PlutusCore.Value
+import PlutusCore.UPLC.CekValue
+import PlutusCore.UPLC.Term
+import PlutusCore.UPLC.BuiltinFunctions.Utils
+
+namespace PlutusCore.UPLC.BuiltinFunctions.Value
+
+namespace PLC
+  export PlutusCore.Value (
+    insertCoin
+    lookupCoin
+    unionValue
+    valueContains
+    valueData
+    unValueData
+  )
+end PLC
+
+open PlutusCore.UPLC.Term
+open PlutusCore.UPLC.CekValue
+
+/-! ## CEK wrappers for the CIP-153 builtin `Value` operations.
+
+Semantics live in `PlutusCore.Value` (a model of plutus-core `Value.hs`);
+`Option.none` here models `BuiltinResult` failure and the CEK machine turns it
+into an evaluation error.
+
+NOTE: Args are deliberately reversed on the Cek machine stack for performance
+(same convention as every other file in this directory). -/
+
+-- insertCoin : bytestring → bytestring → integer → value → value
+-- Eval args (reversed): [value, amount, tokenName, currencySymbol]
+def insertCoin (Vs : List CekValue) : Option CekValue :=
+  match Vs with
+  | [.VCon (.Value v), .VCon (.Integer amt),
+     .VCon (.ByteString tok), .VCon (.ByteString cur)] =>
+      (PLC.insertCoin cur tok amt v).map (.VCon ∘ .Value)
+  | _ => none
+
+-- lookupCoin : bytestring → bytestring → value → integer
+-- Eval args (reversed): [value, tokenName, currencySymbol]
+def lookupCoin (Vs : List CekValue) : Option CekValue :=
+  match Vs with
+  | [.VCon (.Value v), .VCon (.ByteString tok), .VCon (.ByteString cur)] =>
+      some (.VCon (.Integer (PLC.lookupCoin cur tok v)))
+  | _ => none
+
+-- unionValue : value → value → value
+-- Eval args (reversed): [v₂, v₁]
+def unionValue (Vs : List CekValue) : Option CekValue :=
+  match Vs with
+  | [.VCon (.Value v₂), .VCon (.Value v₁)] =>
+      (PLC.unionValue v₁ v₂).map (.VCon ∘ .Value)
+  | _ => none
+
+-- valueContains : value → value → bool
+-- Eval args (reversed): [v₂, v₁]; `v₁` is the container.
+def valueContains (Vs : List CekValue) : Option CekValue :=
+  match Vs with
+  | [.VCon (.Value v₂), .VCon (.Value v₁)] =>
+      (PLC.valueContains v₁ v₂).map (.VCon ∘ .Bool)
+  | _ => none
+
+-- valueData : value → data
+def valueData (Vs : List CekValue) : Option CekValue :=
+  match Vs with
+  | [.VCon (.Value v)] => some (.VCon (.Data (PLC.valueData v)))
+  | _ => none
+
+-- unValueData : data → value
+def unValueData (Vs : List CekValue) : Option CekValue :=
+  match Vs with
+  | [.VCon (.Data d)] => (PLC.unValueData d).map (.VCon ∘ .Value)
+  | _ => none
+
+end PlutusCore.UPLC.BuiltinFunctions.Value
