+/-- `ValueTotalSize` measure of the value constant at position i: number of
+    distinct (currency, token) pairs (plutus ExMemoryUsage.hs:411-415). -/
+def argValueTotalSize (args : List CekValue) (i : Nat) : Nat :=
+  match args[i]? with
+  | some (.VCon (.Value v)) => PlutusCore.Value.totalSize v
+  | _ => 0
+
+/-- `ValueMaxDepth` measure of the value constant at position i:
+    (⌊log₂ m⌋ + 1) + (⌊log₂ k⌋ + 1) for outer-map size m and max inner-map
+    size k, each addend 0 when the size is 0 (plutus ExMemoryUsage.hs:436-446;
+    `integerLog2` is floor-log2, i.e. `Nat.log2`). -/
+def argValueMaxDepth (args : List CekValue) (i : Nat) : Nat :=
+  match args[i]? with
+  | some (.VCon (.Value v)) =>
+      let outerSize := v.length
+      let innerSize := PlutusCore.Value.maxInnerSize v
+      (if outerSize > 0 then Nat.log2 outerSize + 1 else 0) +
+      (if innerSize > 0 then Nat.log2 innerSize + 1 else 0)
+  | _ => 0
+
+mutual
+  /-- `DataNodeCount` measure: total number of `Data` nodes
+      (plutus ExMemoryUsage.hs:391-404, each node contributes 1). -/
+  def dataNodeCount : Data → Nat
+    | Data.Constr _ ds => 1 + dataNodeCountList ds
+    | Data.Map kvs => 1 + dataNodeCountMap kvs
+    | Data.List ds => 1 + dataNodeCountList ds
+    | Data.I _ => 1
+    | Data.B _ => 1
+
+  def dataNodeCountList : List Data → Nat
+    | [] => 0
+    | d :: ds => dataNodeCount d + dataNodeCountList ds
+
+  def dataNodeCountMap : List (Data × Data) → Nat
+    | [] => 0
+    | (k, v) :: kvs => dataNodeCount k + dataNodeCount v + dataNodeCountMap kvs
+end
+
+/-- `DataNodeCount` of the data constant at position i in the CEK args. -/
+def argDataNodeCount (args : List CekValue) (i : Nat) : Nat :=
+  match args[i]? with
+  | some (.VCon (.Data d)) => dataNodeCount d
+  | _ => 0
+
 def maxArgSize (args : List CekValue) : Nat :=
   match args.map cekValueSize with
   | [] => 1 -- 1?
