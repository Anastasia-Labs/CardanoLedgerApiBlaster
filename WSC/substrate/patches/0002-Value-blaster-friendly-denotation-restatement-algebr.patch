+/-- Per-slot lookup directly on the inner list of a `Data` map encoding
+    (first-order recursion; skips malformed entries, which a successful
+    decode excludes anyway). -/
+def lookupDataInner (tok : ByteString) : List (Data × Data) → Integer
+  | [] => 0
+  | (Data.B t, Data.I q) :: rest =>
+      if t == tok then q else lookupDataInner tok rest
+  | _ :: rest => lookupDataInner tok rest
+
+/-- Per-slot lookup directly on the outer list of a `Data` map encoding. -/
+def lookupDataOuter (cur tok : ByteString) : List (Data × Data) → Integer
+  | [] => 0
+  | (Data.B c, Data.Map ts) :: rest =>
+      if c == cur then lookupDataInner tok ts else lookupDataOuter cur tok rest
+  | _ :: rest => lookupDataOuter cur tok rest
+
+/-- Per-slot lookup directly on a `Data` `Value` encoding. -/
+def lookupData (cur tok : ByteString) : Data → Integer
+  | Data.Map cs => lookupDataOuter cur tok cs
+  | _ => 0
+
+/-- Soundness of the inner decoder, three payloads at once: a successful
+    decode is fully normalized, `innerToData` inverts it, and its lookups
+    mirror the `Data`-level walk. -/
+theorem unValueDataTokens_sound :
+    ∀ (ts : List (Data × Data)) (prev : Option ByteString)
+      (l : List (ByteString × Integer)),
+      unValueDataTokens prev ts = some l →
+      innerNormFrom prev l = true ∧ innerToData l = ts ∧
+        ∀ t', lookupInner t' l = lookupDataInner t' ts := by
+  intro ts
+  induction ts with
+  | nil =>
+      intro prev l h
+      simp only [unValueDataTokens, Option.some.injEq] at h
+      subst h
+      exact ⟨rfl, rfl, fun _ => rfl⟩
+  | cons hd rest ih =>
+      intro prev l h
+      obtain ⟨tD, qD⟩ := hd
+      cases tD with
+      | B t =>
+          cases qD with
+          | I q =>
+              cases h1 : validKey t with
+              | false => simp [unValueDataTokens, h1] at h
+              | true =>
+                cases h2 : ascendingFrom prev t with
+                | false => simp [unValueDataTokens, h1, h2] at h
+                | true =>
+                  cases h3 : q == 0 with
+                  | true => simp [unValueDataTokens, h1, h2, h3] at h
+                  | false =>
+                    cases h4 : validQuantity q with
+                    | false => simp [unValueDataTokens, h1, h2, h3, h4] at h
+                    | true =>
+                      cases h5 : unValueDataTokens (some t) rest with
+                      | none => simp [unValueDataTokens, h1, h2, h3, h4, h5] at h
+                      | some l' =>
+                          simp [unValueDataTokens, h1, h2, h3, h4, h5] at h
+                          subst h
+                          obtain ⟨hn, he, hl⟩ := ih (some t) l' h5
+                          refine ⟨?_, ?_, ?_⟩
+                          · simp only [innerNormFrom, Bool.and_eq_true]
+                            exact ⟨⟨⟨⟨h1, h2⟩, by simp [h3]⟩, h4⟩, hn⟩
+                          · simp [innerToData, he]
+                          · intro t'
+                            simp [lookupInner, lookupDataInner, hl t']
+          | Constr i args => simp [unValueDataTokens] at h
+          | Map m => simp [unValueDataTokens] at h
+          | List xs => simp [unValueDataTokens] at h
+          | B b => simp [unValueDataTokens] at h
+      | Constr i args => simp [unValueDataTokens] at h
+      | Map m => simp [unValueDataTokens] at h
+      | List xs => simp [unValueDataTokens] at h
+      | I i => simp [unValueDataTokens] at h
+
+/-- Encoding direction of the inner round trip: a normalized inner list
+    decodes back from its `innerToData` image. -/
+theorem unValueDataTokens_innerToData :
+    ∀ (l : List (ByteString × Integer)) (prev : Option ByteString),
+      innerNormFrom prev l = true →
+      unValueDataTokens prev (innerToData l) = some l := by
+  intro l
+  induction l with
+  | nil => intro prev _; rfl
+  | cons hd tl ih =>
+      intro prev h
+      obtain ⟨t, q⟩ := hd
+      simp only [innerNormFrom, Bool.and_eq_true] at h
+      obtain ⟨⟨⟨⟨h1, h2⟩, h3⟩, h4⟩, h5⟩ := h
+      have h3' : (q == 0) = false := by simpa using h3
+      simp [innerToData, unValueDataTokens, h1, h2, h3', h4, ih (some t) h5]
+
