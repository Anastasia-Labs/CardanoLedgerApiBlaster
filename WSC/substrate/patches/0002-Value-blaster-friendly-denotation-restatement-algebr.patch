+import PlutusCore.Value.Basic
+
+/-! ## Builtin-algebra lemmas for the CIP-153 `Value` denotations.
+
+The four lemma groups needed by algebra-assisted UPLC proofs about programs
+that use the CIP-153 builtins (`lookupCoin` after `insertCoin`, `lookupCoin`
+distributing over `unionValue`, the pointwise characterization of
+`valueContains`, and the `valueData`/`unValueData` round trip): they let a
+consumer characterize every builtin call by its per-key `lookupCoin` algebra,
+so downstream SMT reasoning happens over integer `(+, ≤)` instead of symbolic
+map merges.
+
+All proofs are plain Lean (`induction`/`simp`/`omega`) — no `blaster`, no
+`sorry`/`admit` — so every theorem here can be fed to Blaster goals via
+`have`-threading without audit noise.
+
+Well-formedness: builtin `Value`s are normalized by construction (strictly
+ascending keys on both levels; the decoder, `packValue` and all operations
+preserve this), but the raw `ValueRep` type does not enforce it, so the
+lemmas that depend on key uniqueness take explicit `valueSorted`/
+`valueNormalized` hypotheses. `unValueData_normalized` discharges them for
+any value obtained by decoding, `unionValue_sorted` for any value obtained
+by union. -/
+
+namespace PlutusCore.Value
+
+open PlutusCore.ByteString (ByteString)
+open PlutusCore.ByteString
+open PlutusCore.Integer (Integer)
+open PlutusCore.Data (Data)
+
+/-! ### ByteString strict-order toolkit -/
+
+theorem bs_lt_trans {a b c : ByteString} (h₁ : a < b) (h₂ : b < c) : a < c :=
+  String.lt_trans (a := a.data) h₁ h₂
+
+theorem bs_lt_asymm {a b : ByteString} (h : a < b) : ¬ b < a :=
+  String.lt_asymm (a := a.data) h
+
+/-- Connexity: two mutually-incomparable byte strings are equal. -/
+theorem bs_connex {a b : ByteString} (h₁ : ¬ a < b) (h₂ : ¬ b < a) : a = b := by
+  cases a with | mk da => cases b with | mk db =>
+  have : da = db := String.le_antisymm (String.not_lt.mp h₂) (String.not_lt.mp h₁)
+  simp [this]
+
+theorem bs_lt_ne {a b : ByteString} (h : a < b) : a ≠ b := by
+  intro he
+  subst he
+  exact ByteString.lt_irrefl a h
+
+theorem bs_beq_symm_false {a b : ByteString} (h : (a == b) = false) :
+    (b == a) = false :=
+  beq_false_of_ne (ne_of_beq_false h).symm
+
+theorem bs_beq_symm_true {a b : ByteString} (h : (a == b) = true) :
+    (b == a) = true := by
+  have : a = b := by simpa using h
+  simp [this]
+
+/-! ### Well-formedness predicates (first-order Bool recursions) -/
+
+/-- Token keys strictly ascending, starting strictly above an optional bound. -/
+def innerSortedFrom : Option ByteString → List (ByteString × Integer) → Bool
+  | _, [] => true
+  | prev, (t, _) :: rest => ascendingFrom prev t && innerSortedFrom (some t) rest
+
+/-- Currency keys strictly ascending above an optional bound, every inner list
+    sorted. -/
+def outerSortedFrom : Option ByteString → ValueRep → Bool
+  | _, [] => true
+  | prev, (c, inner) :: rest =>
+      ascendingFrom prev c && innerSortedFrom none inner &&
+        outerSortedFrom (some c) rest
+
+/-- Keys strictly ascending at both levels (key uniqueness; what the lookup
+    lemmas need). -/
+def valueSorted (v : ValueRep) : Bool := outerSortedFrom none v
+
+/-- Inner-level full normalization: sorted, valid keys, no zero quantity,
+    quantities within the signed 128-bit bounds (exactly the `unValueData`
+    inner-decoder checks). -/
+def innerNormFrom : Option ByteString → List (ByteString × Integer) → Bool
+  | _, [] => true
+  | prev, (t, q) :: rest =>
+      validKey t && ascendingFrom prev t && !(q == 0) && validQuantity q &&
+        innerNormFrom (some t) rest
+
+/-- Outer-level full normalization: sorted, valid keys, no empty inner list,
+    every inner list fully normalized (exactly the `unValueData`
+    outer-decoder checks). -/
+def outerNormFrom : Option ByteString → ValueRep → Bool
+  | _, [] => true
+  | _, (_, []) :: _ => false
+  | prev, (c, i₀ :: is) :: rest =>
+      validKey c && ascendingFrom prev c && innerNormFrom none (i₀ :: is) &&
+        outerNormFrom (some c) rest
+
+/-- The invariant of the Haskell `Value` type (`Value.hs` "Invariants"): what
+    `unValueData` accepts and what `valueData` needs for the round trip. -/
+def valueNormalized (v : ValueRep) : Bool := outerNormFrom none v
+
+@[simp] theorem ascendingFrom_none (t : ByteString) :
+    ascendingFrom none t = true := rfl
+
+@[simp] theorem ascendingFrom_some_iff {p t : ByteString} :
+    ascendingFrom (some p) t = true ↔ p < t := by
+  simp [ascendingFrom]
+
+theorem ascendingFrom_of_lt {lb : Option ByteString} {a b : ByteString}
+    (hab : ascendingFrom (some a) b = true) (h : ascendingFrom lb a = true) :
+    ascendingFrom lb b = true := by
+  cases lb with
+  | none => rfl
+  | some p =>
+      simp only [ascendingFrom_some_iff] at *
+      exact bs_lt_trans h hab
+
+/-- Weakening: a list sorted strictly above `t` is sorted above any bound that
+    `t` itself clears. -/
+theorem innerSortedFrom_weaken {lb : Option ByteString} {t : ByteString}
+    {l : List (ByteString × Integer)}
+    (hb : ascendingFrom lb t = true) (h : innerSortedFrom (some t) l = true) :
+    innerSortedFrom lb l = true := by
+  cases l with
+  | nil => rfl
+  | cons hd tl =>
+      obtain ⟨t', q'⟩ := hd
+      simp only [innerSortedFrom, Bool.and_eq_true] at h ⊢
+      exact ⟨ascendingFrom_of_lt h.1 hb, h.2⟩
+
+theorem outerSortedFrom_weaken {lb : Option ByteString} {c : ByteString}
+    {v : ValueRep}
+    (hb : ascendingFrom lb c = true) (h : outerSortedFrom (some c) v = true) :
+    outerSortedFrom lb v = true := by
+  cases v with
+  | nil => rfl
+  | cons hd tl =>
+      obtain ⟨c', i'⟩ := hd
+      simp only [outerSortedFrom, Bool.and_eq_true] at h ⊢
+      exact ⟨⟨ascendingFrom_of_lt h.1.1 hb, h.1.2⟩, h.2⟩
+
+/-! ### Lookup basics -/
+
+/-- A list sorted strictly above `lb` has no key at or below `lb`. -/
+theorem lookupInner_zero_of_bound {t lb : ByteString}
+    {l : List (ByteString × Integer)}
+    (hs : innerSortedFrom (some lb) l = true) (hlt : ¬ lb < t) :
+    lookupInner t l = 0 := by
+  induction l generalizing lb with
+  | nil => rfl
+  | cons hd tl ih =>
+      obtain ⟨t₀, q₀⟩ := hd
+      simp only [innerSortedFrom, Bool.and_eq_true, ascendingFrom_some_iff] at hs
+      rw [lookupInner]
+      cases hbe : t₀ == t with
+      | true =>
+          have : t₀ = t := by simpa using hbe
+          exact absurd (this ▸ hs.1) hlt
+      | false =>
+          simp only [Bool.false_eq_true, if_neg]
+          exact ih hs.2 (fun hlt' => hlt (bs_lt_trans hs.1 hlt'))
+
+theorem lookupCoin_zero_of_bound {c t lb : ByteString} {v : ValueRep}
+    (hs : outerSortedFrom (some lb) v = true) (hlt : ¬ lb < c) :
+    lookupCoin c t v = 0 := by
+  induction v generalizing lb with
+  | nil => rfl
+  | cons hd tl ih =>
+      obtain ⟨c₀, i₀⟩ := hd
+      simp only [outerSortedFrom, Bool.and_eq_true, ascendingFrom_some_iff] at hs
+      rw [lookupCoin]
+      cases hbe : c₀ == c with
+      | true =>
+          have : c₀ = c := by simpa using hbe
+          exact absurd (this ▸ hs.1.1) hlt
+      | false =>
+          simp only [Bool.false_eq_true, if_neg]
+          exact ih hs.2 (fun hlt' => hlt (bs_lt_trans hs.1.1 hlt'))
+
+/-- Without negative amounts every lookup is non-negative (inner level). -/
+theorem lookupInner_nonneg {t : ByteString} {l : List (ByteString × Integer)}
+    (h : innerHasNegative l = false) : 0 ≤ lookupInner t l := by
+  induction l with
+  | nil => simp [lookupInner]
+  | cons hd tl ih =>
+      obtain ⟨t₀, q₀⟩ := hd
+      simp only [innerHasNegative, Bool.or_eq_false_iff, decide_eq_false_iff_not,
+        Int.not_lt] at h
+      rw [lookupInner]
+      cases hbe : t₀ == t with
+      | true => simpa using h.1
+      | false => simpa using ih h.2
+
+/-- Without negative amounts every lookup is non-negative. -/
+theorem lookupCoin_nonneg {c t : ByteString} {v : ValueRep}
+    (h : hasNegativeAmount v = false) : 0 ≤ lookupCoin c t v := by
+  induction v with
+  | nil => simp [lookupCoin]
+  | cons hd tl ih =>
+      obtain ⟨c₀, i₀⟩ := hd
+      simp only [hasNegativeAmount, Bool.or_eq_false_iff] at h
+      rw [lookupCoin]
+      cases hbe : c₀ == c with
+      | true => simpa using lookupInner_nonneg (t := t) h.1
+      | false => simpa using ih h.2
+
+/-! ### Lemma group 1 — `lookupCoin` after `insertCoin` (hit and miss)
+
+`insertCoin` has two arms: quantity 0 deletes via `deleteCoin`, anything else
+inserts via `insertUnsafe`; the lemmas cover both. -/
+
+theorem lookupInner_innerDelete_self (tok : ByteString)
+    (l : List (ByteString × Integer)) :
+    lookupInner tok (innerDelete tok l) = 0 := by
+  induction l with
+  | nil => rfl
+  | cons hd tl ih =>
+      obtain ⟨t, q⟩ := hd
+      rw [innerDelete]
+      cases hbe : t == tok with
+      | true => simpa using ih
+      | false => rw [if_neg (by simp [hbe]), lookupInner, if_neg (by simp [hbe])]; exact ih
+
+theorem lookupInner_innerDelete_other {tok t' : ByteString}
+    (h : t' ≠ tok) (l : List (ByteString × Integer)) :
+    lookupInner t' (innerDelete tok l) = lookupInner t' l := by
+  induction l with
+  | nil => rfl
+  | cons hd tl ih =>
+      obtain ⟨t, q⟩ := hd
+      rw [innerDelete]
+      cases hbe : t == tok with
+      | true =>
+          have ht : t = tok := by simpa using hbe
+          have h2 : (t == t') = false := by
+            rw [ht]; exact beq_false_of_ne fun he => h he.symm
+          simp [hbe, lookupInner, h2, ih]
+      | false =>
+          simp only [hbe, Bool.false_eq_true, if_false, lookupInner]
+          cases hbe' : t == t' <;> simp [hbe', ih]
+
+/-- If deleting `tok` empties an inner list, the list held nothing else. -/
+theorem lookupInner_zero_of_innerDelete_nil {tok t' : ByteString}
+    {l : List (ByteString × Integer)}
+    (hne : t' ≠ tok) (h : innerDelete tok l = []) : lookupInner t' l = 0 := by
+  have := lookupInner_innerDelete_other (l := l) hne
+  rw [h] at this
+  exact this.symm.trans rfl
+
+theorem lookupCoin_deleteCoin_self {cur tok : ByteString} {v : ValueRep}
+    {lb : Option ByteString} (hs : outerSortedFrom lb v = true) :
+    lookupCoin cur tok (deleteCoin cur tok v) = 0 := by
+  induction v generalizing lb with
+  | nil => rfl
+  | cons hd tl ih =>
+      obtain ⟨c, inner⟩ := hd
+      simp only [outerSortedFrom, Bool.and_eq_true] at hs
+      rw [deleteCoin]
+      cases hbe : c == cur with
+      | true =>
+          have hc : c = cur := by simpa using hbe
+          rw [if_pos (by simp [hbe])]
+          cases hd : innerDelete tok inner with
+          | nil =>
+              exact lookupCoin_zero_of_bound (lb := c) hs.2
+                (hc ▸ ByteString.lt_irrefl c)
+          | cons a l' =>
+              rw [lookupCoin, if_pos (by simp [hbe]), ← hd,
+                lookupInner_innerDelete_self]
+      | false =>
+          rw [if_neg (by simp [hbe]), lookupCoin, if_neg (by simp [hbe])]
+          exact ih hs.2
+
+theorem lookupCoin_deleteCoin_other {cur tok c' t' : ByteString} {v : ValueRep}
+    {lb : Option ByteString} (hs : outerSortedFrom lb v = true)
+    (hne : c' ≠ cur ∨ t' ≠ tok) :
+    lookupCoin c' t' (deleteCoin cur tok v) = lookupCoin c' t' v := by
+  induction v generalizing lb with
+  | nil => rfl
+  | cons hd tl ih =>
+      obtain ⟨c, inner⟩ := hd
+      simp only [outerSortedFrom, Bool.and_eq_true] at hs
+      rw [deleteCoin]
+      cases hbe : c == cur with
+      | true =>
+          have hc : c = cur := by simpa using hbe
+          rw [if_pos (by simp [hbe])]
+          cases hd : innerDelete tok inner with
+          | nil =>
+              rw [lookupCoin]
+              cases hbe' : c == c' with
+              | true =>
+                  have hcc : c = c' := by simpa using hbe'
+                  have ht : t' ≠ tok := by
+                    rcases hne with h | h
+                    · exact absurd (hcc.symm.trans hc) h
+                    · exact h
+                  rw [if_pos (by simp [hbe']),
+                    lookupInner_zero_of_innerDelete_nil ht hd,
+                    lookupCoin_zero_of_bound (lb := c) hs.2
+                      (hcc ▸ ByteString.lt_irrefl c)]
+              | false => rw [if_neg (by simp [hbe'])]
+          | cons a l' =>
+              rw [lookupCoin, lookupCoin]
+              cases hbe' : c == c' with
+              | true =>
+                  have hcc : c = c' := by simpa using hbe'
+                  have ht : t' ≠ tok := by
+                    rcases hne with h | h
+                    · exact absurd (hcc.symm.trans hc) h
+                    · exact h
+                  rw [if_pos (by simp [hbe']), if_pos (by simp [hbe']), ← hd,
+                    lookupInner_innerDelete_other ht]
+              | false =>
+                  rw [if_neg (by simp [hbe']), if_neg (by simp [hbe'])]
+      | false =>
+          rw [if_neg (by simp [hbe]), lookupCoin, lookupCoin]
+          cases hbe' : c == c' with
+          | true => rw [if_pos (by simp [hbe']), if_pos (by simp [hbe'])]
+          | false =>
+              rw [if_neg (by simp [hbe']), if_neg (by simp [hbe'])]
+              exact ih hs.2
+
+theorem lookupInner_innerInsert_self (tok : ByteString) (a : Integer)
+    (l : List (ByteString × Integer)) :
+    lookupInner tok (innerInsert tok a l) = a := by
+  induction l with
+  | nil => simp [innerInsert, lookupInner]
+  | cons hd tl ih =>
+      obtain ⟨t, q⟩ := hd
+      rw [innerInsert]
+      by_cases hlt : tok < t
+      · simp [hlt, lookupInner]
+      · cases hbe : tok == t with
+        | true => simp [hlt, hbe, lookupInner]
+        | false =>
+            have h2 : (t == tok) = false := bs_beq_symm_false hbe
+            simp [hlt, hbe, lookupInner, h2, ih]
+
+theorem lookupInner_innerInsert_other {tok t' : ByteString} (a : Integer)
+    (hne : t' ≠ tok) (l : List (ByteString × Integer)) :
+    lookupInner t' (innerInsert tok a l) = lookupInner t' l := by
+  have hne' : (tok == t') = false := beq_false_of_ne fun he => hne he.symm
+  induction l with
+  | nil => simp [innerInsert, lookupInner, hne']
+  | cons hd tl ih =>
+      obtain ⟨t, q⟩ := hd
+      rw [innerInsert]
+      by_cases hlt : tok < t
+      · simp [hlt, lookupInner, hne']
+      · cases hbe : tok == t with
+        | true =>
+            have ht : tok = t := by simpa using hbe
+            have h2 : (t == t') = false := by rw [← ht]; exact hne'
+            simp [hlt, hbe, lookupInner, hne', h2]
+        | false =>
+            simp only [hlt, hbe, Bool.false_eq_true, if_false, lookupInner]
+            cases hbe' : t == t' <;> simp [hbe', ih]
+
+theorem lookupCoin_insertUnsafe_self (cur tok : ByteString) (a : Integer)
+    (v : ValueRep) :
+    lookupCoin cur tok (insertUnsafe cur tok a v) = a := by
+  induction v with
+  | nil => simp [insertUnsafe, lookupCoin, lookupInner]
+  | cons hd tl ih =>
+      obtain ⟨c, inner⟩ := hd
+      rw [insertUnsafe]
+      by_cases hlt : cur < c
+      · simp [hlt, lookupCoin, lookupInner]
+      · cases hbe : cur == c with
+        | true =>
+            have h2 : (c == cur) = true := bs_beq_symm_true hbe
+            simp [hlt, hbe, lookupCoin, h2, lookupInner_innerInsert_self]
+        | false =>
+            have h2 : (c == cur) = false := bs_beq_symm_false hbe
+            simp [hlt, hbe, lookupCoin, h2, ih]
+
+theorem lookupCoin_insertUnsafe_other {cur tok c' t' : ByteString} (a : Integer)
+    {v : ValueRep} {lb : Option ByteString}
+    (hs : outerSortedFrom lb v = true) (hne : c' ≠ cur ∨ t' ≠ tok) :
+    lookupCoin c' t' (insertUnsafe cur tok a v) = lookupCoin c' t' v := by
+  induction v generalizing lb with
+  | nil =>
+      cases hbe : cur == c' with
+      | true =>
+          have hc : cur = c' := by simpa using hbe
+          have ht : t' ≠ tok := by
+            rcases hne with h | h
+            · exact absurd hc.symm h
+            · exact h
+          have h2 : (tok == t') = false := beq_false_of_ne fun he => ht he.symm
+          simp [insertUnsafe, lookupCoin, lookupInner, hbe, h2]
+      | false => simp [insertUnsafe, lookupCoin, hbe]
+  | cons hd tl ih =>
+      obtain ⟨c, inner⟩ := hd
+      simp only [outerSortedFrom, Bool.and_eq_true] at hs
+      rw [insertUnsafe]
+      by_cases hlt : cur < c
+      · -- new head (cur, [(tok, a)]) prepended before (c, inner) :: tl
+        cases hbe : cur == c' with
+        | true =>
+            have hc : cur = c' := by simpa using hbe
+            have ht : t' ≠ tok := by
+              rcases hne with h | h
+              · exact absurd hc.symm h
+              · exact h
+            have h2 : (tok == t') = false := beq_false_of_ne fun he => ht he.symm
+            have hz : lookupCoin c' t' ((c, inner) :: tl) = 0 :=
+              lookupCoin_zero_of_bound (lb := cur)
+                (by simp only [outerSortedFrom, Bool.and_eq_true]
+                    exact ⟨⟨by simpa using hlt, hs.1.2⟩, hs.2⟩)
+                (hc ▸ ByteString.lt_irrefl cur)
+            rw [if_pos hlt, lookupCoin, if_pos hbe, hz]
+            simp [lookupInner, h2]
+        | false => simp [hlt, lookupCoin, hbe]
+      · cases hbe : cur == c with
+        | true =>
+            have hc : cur = c := by simpa using hbe
+            cases hbe' : c == c' with
+            | true =>
+                have hcc : c = c' := by simpa using hbe'
+                have ht : t' ≠ tok := by
+                  rcases hne with h | h
+                  · exact absurd (hc.trans hcc).symm h
+                  · exact h
+                simp [hlt, hbe, hbe', lookupCoin,
+                  lookupInner_innerInsert_other a ht]
+            | false => simp [hlt, hbe, hbe', lookupCoin]
+        | false =>
+            cases hbe' : c == c' with
+            | true => simp [hlt, hbe, hbe', lookupCoin]
+            | false => simp [hlt, hbe, hbe', lookupCoin, ih hs.2]
+
+/-- **Lemma group 1 (hit)**: after a successful `insertCoin cur tok amt`,
+    looking up `(cur, tok)` returns `amt` — including the `amt = 0` delete arm,
+    where the lookup returns 0. -/
+theorem lookupCoin_insertCoin_hit {cur tok : ByteString} {amt : Integer}
+    {v v' : ValueRep} (hs : valueSorted v = true)
+    (h : insertCoin cur tok amt v = some v') :
+    lookupCoin cur tok v' = amt := by
+  rw [insertCoin] at h
+  by_cases h0 : amt == 0
+  · rw [if_pos h0] at h
+    obtain rfl : deleteCoin cur tok v = v' := by simpa using h
+    have : amt = 0 := by simpa using h0
+    rw [this, lookupCoin_deleteCoin_self (lb := none) hs]
+  · rw [if_neg h0] at h
+    by_cases h1 : validKey cur
+    · rw [if_pos h1] at h
+      by_cases h2 : validKey tok
+      · rw [if_pos h2] at h
+        by_cases h3 : validQuantity amt
+        · rw [if_pos h3] at h
+          obtain rfl : insertUnsafe cur tok amt v = v' := by simpa using h
+          exact lookupCoin_insertUnsafe_self cur tok amt v
+        · rw [if_neg h3] at h; exact absurd h (by simp)
+      · rw [if_neg h2] at h; exact absurd h (by simp)
+    · rw [if_neg h1] at h; exact absurd h (by simp)
+
+/-- **Lemma group 1 (miss)**: a successful `insertCoin cur tok amt` leaves
+    every other `(c', t')` slot unchanged. -/
+theorem lookupCoin_insertCoin_miss {cur tok c' t' : ByteString} {amt : Integer}
+    {v v' : ValueRep} (hs : valueSorted v = true)
+    (h : insertCoin cur tok amt v = some v') (hne : c' ≠ cur ∨ t' ≠ tok) :
+    lookupCoin c' t' v' = lookupCoin c' t' v := by
+  rw [insertCoin] at h
+  by_cases h0 : amt == 0
+  · rw [if_pos h0] at h
+    obtain rfl : deleteCoin cur tok v = v' := by simpa using h
+    exact lookupCoin_deleteCoin_other (lb := none) hs hne
+  · rw [if_neg h0] at h
+    by_cases h1 : validKey cur
+    · rw [if_pos h1] at h
+      by_cases h2 : validKey tok
+      · rw [if_pos h2] at h
+        by_cases h3 : validQuantity amt
+        · rw [if_pos h3] at h
+          obtain rfl : insertUnsafe cur tok amt v = v' := by simpa using h
+          exact lookupCoin_insertUnsafe_other (lb := none) amt hs hne
+        · rw [if_neg h3] at h; exact absurd h (by simp)
+      · rw [if_neg h2] at h; exact absurd h (by simp)
+    · rw [if_neg h1] at h; exact absurd h (by simp)
+
+/-! ### Lemma group 2 — `lookupCoin` distributes over `unionValue`
+
+`unionValue` is a two-level sorted merge; on the success branch every slot of
+the result is the integer sum of the two argument slots, and on the failure
+branch some slot sum leaves the 128-bit `Quantity` bounds. -/
+
+set_option maxRecDepth 20000 in
+theorem validQuantity_zero : validQuantity 0 = true := by decide
+
+theorem unionInner_sortedFrom (i₁ i₂ : List (ByteString × Integer)) :
+    ∀ (lb : Option ByteString) (r : List (ByteString × Integer)),
+      innerSortedFrom lb i₁ = true → innerSortedFrom lb i₂ = true →
+      unionInner i₁ i₂ = some r → innerSortedFrom lb r = true := by
+  induction i₁, i₂ using unionInner.induct with
+  | case1 ys =>
+      intro lb r h₁ h₂ h
+      simp only [unionInner, Option.some.injEq] at h
+      exact h ▸ h₂
+  | case2 x xs =>
+      intro lb r h₁ h₂ h
+      simp only [unionInner, Option.some.injEq] at h
+      exact h ▸ h₁
+  | case3 t₁ q₁ xs t₂ q₂ ys hlt hnone ih =>
+      intro lb r h₁ h₂ h
+      rw [unionInner_lt_eq _ _ _ _ _ _ hlt, hnone] at h
+      simp at h
+  | case4 t₁ q₁ xs t₂ q₂ ys hlt rest hsome ih =>
+      intro lb r h₁ h₂ h
+      rw [unionInner_lt_eq _ _ _ _ _ _ hlt, hsome] at h
+      simp only [Option.map_some, Option.some.injEq] at h
+      subst h
+      simp only [innerSortedFrom, Bool.and_eq_true] at h₁ h₂ ⊢
+      refine ⟨h₁.1, ?_⟩
+      exact ih (some t₁) rest h₁.2
+        (by simp only [innerSortedFrom, Bool.and_eq_true]
+            exact ⟨by simpa using hlt, h₂.2⟩) hsome
+  | case5 t₁ q₁ xs t₂ q₂ ys hnlt hgt hnone ih =>
+      intro lb r h₁ h₂ h
+      rw [unionInner_gt_eq _ _ _ _ _ _ hnlt hgt, hnone] at h
+      simp at h
+  | case6 t₁ q₁ xs t₂ q₂ ys hnlt hgt rest hsome ih =>
+      intro lb r h₁ h₂ h
+      rw [unionInner_gt_eq _ _ _ _ _ _ hnlt hgt, hsome] at h
+      simp only [Option.map_some, Option.some.injEq] at h
+      subst h
+      simp only [innerSortedFrom, Bool.and_eq_true] at h₁ h₂ ⊢
+      refine ⟨h₂.1, ?_⟩
+      exact ih (some t₂) rest
+        (by simp only [innerSortedFrom, Bool.and_eq_true]
+            exact ⟨by simpa using hgt, h₁.2⟩) h₂.2 hsome
+  | case7 t₁ q₁ xs t₂ q₂ ys hnlt hngt hv hnone ih =>
+      intro lb r h₁ h₂ h
+      rw [unionInner_collision_eq _ _ _ _ _ _ hnlt hngt, if_pos hv, hnone] at h
+      simp at h
+  | case8 t₁ q₁ xs t₂ q₂ ys hnlt hngt hv rest hsome ih =>
+      intro lb r h₁ h₂ h
+      have heq : t₁ = t₂ := bs_connex hnlt hngt
+      subst heq
+      rw [unionInner_collision_eq _ _ _ _ _ _ hnlt hngt, if_pos hv, hsome] at h
+      simp only [Option.map_some, Option.some.injEq] at h
+      subst h
+      simp only [innerSortedFrom, Bool.and_eq_true] at h₁ h₂
+      have hrest : innerSortedFrom (some t₁) rest = true :=
+        ih (some t₁) rest h₁.2 h₂.2 hsome
+      cases hz : q₁ + q₂ == 0 with
+      | true =>
+          simp only [hz, if_true, ite_true]
+          exact innerSortedFrom_weaken h₁.1 hrest
+      | false =>
+          simp only [hz, Bool.false_eq_true, if_false, ite_false,
+            innerSortedFrom, Bool.and_eq_true]
+          exact ⟨h₁.1, hrest⟩
+  | case9 t₁ q₁ xs t₂ q₂ ys hnlt hngt hv =>
+      intro lb r h₁ h₂ h
+      rw [unionInner_collision_eq _ _ _ _ _ _ hnlt hngt, if_neg hv] at h
+      simp at h
+
+theorem unionInner_lookup (i₁ i₂ : List (ByteString × Integer)) :
+    ∀ (lb : Option ByteString) (r : List (ByteString × Integer)) (t : ByteString),
+      innerSortedFrom lb i₁ = true → innerSortedFrom lb i₂ = true →
+      unionInner i₁ i₂ = some r →
+      lookupInner t r = lookupInner t i₁ + lookupInner t i₂ := by
+  induction i₁, i₂ using unionInner.induct with
+  | case1 ys =>
+      intro lb r t h₁ h₂ h
+      simp only [unionInner, Option.some.injEq] at h
+      subst h
+      simp [lookupInner]
+  | case2 x xs =>
+      intro lb r t h₁ h₂ h
+      simp only [unionInner, Option.some.injEq] at h
+      subst h
+      simp [lookupInner]
+  | case3 t₁ q₁ xs t₂ q₂ ys hlt hnone ih =>
+      intro lb r t h₁ h₂ h
+      rw [unionInner_lt_eq _ _ _ _ _ _ hlt, hnone] at h
+      simp at h
+  | case4 t₁ q₁ xs t₂ q₂ ys hlt rest hsome ih =>
+      intro lb r t h₁ h₂ h
+      rw [unionInner_lt_eq _ _ _ _ _ _ hlt, hsome] at h
+      simp only [Option.map_some, Option.some.injEq] at h
+      subst h
+      simp only [innerSortedFrom, Bool.and_eq_true] at h₁ h₂
+      have ihs := ih (some t₁) rest t h₁.2
+        (by simp only [innerSortedFrom, Bool.and_eq_true]
+            exact ⟨by simpa using hlt, h₂.2⟩) hsome
+      cases hbe : t₁ == t with
+      | true =>
+          have ht : t₁ = t := by simpa using hbe
+          have hne : (t₂ == t) = false :=
+            beq_false_of_ne fun he => bs_lt_ne hlt (ht.trans he.symm)
+          have hyz : lookupInner t ys = 0 :=
+            lookupInner_zero_of_bound h₂.2
+              (fun hlt' => bs_lt_asymm hlt (by rwa [ht] : t₂ < t₁))
+          simp [lookupInner, hbe, hne, hyz]
+      | false =>
+          simp [lookupInner, hbe, ihs]
+  | case5 t₁ q₁ xs t₂ q₂ ys hnlt hgt hnone ih =>
+      intro lb r t h₁ h₂ h
+      rw [unionInner_gt_eq _ _ _ _ _ _ hnlt hgt, hnone] at h
+      simp at h
+  | case6 t₁ q₁ xs t₂ q₂ ys hnlt hgt rest hsome ih =>
+      intro lb r t h₁ h₂ h
+      rw [unionInner_gt_eq _ _ _ _ _ _ hnlt hgt, hsome] at h
+      simp only [Option.map_some, Option.some.injEq] at h
+      subst h
+      simp only [innerSortedFrom, Bool.and_eq_true] at h₁ h₂
+      have ihs := ih (some t₂) rest t
+        (by simp only [innerSortedFrom, Bool.and_eq_true]
+            exact ⟨by simpa using hgt, h₁.2⟩) h₂.2 hsome
+      cases hbe : t₂ == t with
+      | true =>
+          have ht : t₂ = t := by simpa using hbe
+          have hne : (t₁ == t) = false :=
+            beq_false_of_ne fun he => bs_lt_ne hgt (ht.trans he.symm)
+          have hxz : lookupInner t xs = 0 :=
+            lookupInner_zero_of_bound h₁.2
+              (fun hlt' => hnlt (by rwa [ht] : t₁ < t₂))
+          simp [lookupInner, hbe, hne, hxz]
+      | false =>
+          simp [lookupInner, hbe, ihs]
+  | case7 t₁ q₁ xs t₂ q₂ ys hnlt hngt hv hnone ih =>
+      intro lb r t h₁ h₂ h
+      rw [unionInner_collision_eq _ _ _ _ _ _ hnlt hngt, if_pos hv, hnone] at h
+      simp at h
+  | case8 t₁ q₁ xs t₂ q₂ ys hnlt hngt hv rest hsome ih =>
+      intro lb r t h₁ h₂ h
+      have heq : t₁ = t₂ := bs_connex hnlt hngt
+      subst heq
+      rw [unionInner_collision_eq _ _ _ _ _ _ hnlt hngt, if_pos hv, hsome] at h
+      simp only [Option.map_some, Option.some.injEq] at h
+      subst h
+      simp only [innerSortedFrom, Bool.and_eq_true] at h₁ h₂
+      have ihs := ih (some t₁) rest t h₁.2 h₂.2 hsome
+      cases hbe : t₁ == t with
+      | true =>
+          have ht : t₁ = t := by simpa using hbe
+          have hxz : lookupInner t xs = 0 :=
+            lookupInner_zero_of_bound h₁.2 (by rw [← ht]; exact ByteString.lt_irrefl t₁)
+          have hyz : lookupInner t ys = 0 :=
+            lookupInner_zero_of_bound h₂.2 (by rw [← ht]; exact ByteString.lt_irrefl t₁)
+          cases hz : q₁ + q₂ == 0 with
+          | true =>
+              have hq : q₁ + q₂ = 0 := by simpa using hz
+              simp [hz, lookupInner, hbe, ihs, hxz, hyz, hq]
+          | false =>
+              simp [hz, lookupInner, hbe]
+      | false =>
+          cases hz : q₁ + q₂ == 0 with
+          | true => simp [hz, lookupInner, hbe, ihs]
+          | false => simp [hz, lookupInner, hbe, ihs]
+  | case9 t₁ q₁ xs t₂ q₂ ys hnlt hngt hv =>
+      intro lb r t h₁ h₂ h
+      rw [unionInner_collision_eq _ _ _ _ _ _ hnlt hngt, if_neg hv] at h
+      simp at h
+
+theorem unionInner_none (i₁ i₂ : List (ByteString × Integer)) :
+    ∀ (lb : Option ByteString),
+      innerSortedFrom lb i₁ = true → innerSortedFrom lb i₂ = true →
+      unionInner i₁ i₂ = none →
+      ∃ t, validQuantity (lookupInner t i₁ + lookupInner t i₂) = false := by
+  induction i₁, i₂ using unionInner.induct with
+  | case1 ys => intro lb h₁ h₂ h; simp [unionInner] at h
+  | case2 x xs => intro lb h₁ h₂ h; simp [unionInner] at h
+  | case3 t₁ q₁ xs t₂ q₂ ys hlt hnone ih =>
+      intro lb h₁ h₂ h
+      simp only [innerSortedFrom, Bool.and_eq_true] at h₁ h₂
+      have hys : innerSortedFrom (some t₁) ((t₂, q₂) :: ys) = true := by
+        simp only [innerSortedFrom, Bool.and_eq_true]
+        exact ⟨by simpa using hlt, h₂.2⟩
+      obtain ⟨t, hbad⟩ := ih (some t₁) h₁.2 hys hnone
+      refine ⟨t, ?_⟩
+      have hne : (t₁ == t) = false := by
+        cases hbe : t₁ == t with
+        | false => rfl
+        | true =>
+            have ht : t₁ = t := by simpa using hbe
+            have hxz : lookupInner t xs = 0 :=
+              lookupInner_zero_of_bound h₁.2 (by rw [← ht]; exact ByteString.lt_irrefl t₁)
+            have hyz : lookupInner t ((t₂, q₂) :: ys) = 0 :=
+              lookupInner_zero_of_bound hys (by rw [← ht]; exact ByteString.lt_irrefl t₁)
+            rw [hxz, hyz] at hbad
+            simp [validQuantity_zero] at hbad
+      simpa [lookupInner, hne] using hbad
+  | case4 t₁ q₁ xs t₂ q₂ ys hlt rest hsome ih =>
+      intro lb h₁ h₂ h
+      rw [unionInner_lt_eq _ _ _ _ _ _ hlt, hsome] at h
+      simp at h
+  | case5 t₁ q₁ xs t₂ q₂ ys hnlt hgt hnone ih =>
+      intro lb h₁ h₂ h
+      simp only [innerSortedFrom, Bool.and_eq_true] at h₁ h₂
+      have hxs : innerSortedFrom (some t₂) ((t₁, q₁) :: xs) = true := by
+        simp only [innerSortedFrom, Bool.and_eq_true]
+        exact ⟨by simpa using hgt, h₁.2⟩
+      obtain ⟨t, hbad⟩ := ih (some t₂) hxs h₂.2 hnone
+      refine ⟨t, ?_⟩
+      have hne : (t₂ == t) = false := by
+        cases hbe : t₂ == t with
+        | false => rfl
+        | true =>
+            have ht : t₂ = t := by simpa using hbe
+            have hxz : lookupInner t ((t₁, q₁) :: xs) = 0 :=
+              lookupInner_zero_of_bound hxs (by rw [← ht]; exact ByteString.lt_irrefl t₂)
+            have hyz : lookupInner t ys = 0 :=
+              lookupInner_zero_of_bound h₂.2 (by rw [← ht]; exact ByteString.lt_irrefl t₂)
+            rw [hxz, hyz] at hbad
+            simp [validQuantity_zero] at hbad
+      simpa [lookupInner, hne] using hbad
+  | case6 t₁ q₁ xs t₂ q₂ ys hnlt hgt rest hsome ih =>
+      intro lb h₁ h₂ h
+      rw [unionInner_gt_eq _ _ _ _ _ _ hnlt hgt, hsome] at h
+      simp at h
+  | case7 t₁ q₁ xs t₂ q₂ ys hnlt hngt hv hnone ih =>
+      intro lb h₁ h₂ h
+      have heq : t₁ = t₂ := bs_connex hnlt hngt
+      subst heq
+      simp only [innerSortedFrom, Bool.and_eq_true] at h₁ h₂
+      obtain ⟨t, hbad⟩ := ih (some t₁) h₁.2 h₂.2 hnone
+      refine ⟨t, ?_⟩
+      have hne : (t₁ == t) = false := by
+        cases hbe : t₁ == t with
+        | false => rfl
+        | true =>
+            have ht : t₁ = t := by simpa using hbe
+            have hxz : lookupInner t xs = 0 :=
+              lookupInner_zero_of_bound h₁.2 (by rw [← ht]; exact ByteString.lt_irrefl t₁)
+            have hyz : lookupInner t ys = 0 :=
+              lookupInner_zero_of_bound h₂.2 (by rw [← ht]; exact ByteString.lt_irrefl t₁)
+            rw [hxz, hyz] at hbad
+            simp [validQuantity_zero] at hbad
+      simpa [lookupInner, hne] using hbad
+  | case8 t₁ q₁ xs t₂ q₂ ys hnlt hngt hv rest hsome ih =>
+      intro lb h₁ h₂ h
+      rw [unionInner_collision_eq _ _ _ _ _ _ hnlt hngt, if_pos hv, hsome] at h
+      simp at h
+  | case9 t₁ q₁ xs t₂ q₂ ys hnlt hngt hv =>
+      intro lb h₁ h₂ h
+      have heq : t₁ = t₂ := bs_connex hnlt hngt
+      subst heq
+      have hf : validQuantity (q₁ + q₂) = false := by simpa using hv
+      exact ⟨t₁, by simp [lookupInner, hf]⟩
+
+theorem unionOuter_sortedFrom (v₁ v₂ : ValueRep) :
+    ∀ (lb : Option ByteString) (r : ValueRep),
+      outerSortedFrom lb v₁ = true → outerSortedFrom lb v₂ = true →
+      unionOuter v₁ v₂ = some r → outerSortedFrom lb r = true := by
+  induction v₁, v₂ using unionOuter.induct with
+  | case1 ys =>
+      intro lb r h₁ h₂ h
+      simp only [unionOuter, Option.some.injEq] at h
+      exact h ▸ h₂
+  | case2 x xs =>
+      intro lb r h₁ h₂ h
+      simp only [unionOuter, Option.some.injEq] at h
+      exact h ▸ h₁
+  | case3 c₁ i₁ xs c₂ i₂ ys hlt hnone ih =>
+      intro lb r h₁ h₂ h
+      simp [unionOuter, hlt, hnone] at h
+  | case4 c₁ i₁ xs c₂ i₂ ys hlt rest hsome ih =>
+      intro lb r h₁ h₂ h
+      simp [unionOuter, hlt, hsome] at h
+      subst h
+      simp only [outerSortedFrom, Bool.and_eq_true] at h₁ h₂ ⊢
+      refine ⟨h₁.1, ?_⟩
+      exact ih (some c₁) rest h₁.2
+        (by simp only [outerSortedFrom, Bool.and_eq_true]
+            exact ⟨⟨by simpa using hlt, h₂.1.2⟩, h₂.2⟩) hsome
+  | case5 c₁ i₁ xs c₂ i₂ ys hnlt hgt hnone ih =>
+      intro lb r h₁ h₂ h
+      simp [unionOuter, hnlt, hgt, hnone] at h
+  | case6 c₁ i₁ xs c₂ i₂ ys hnlt hgt rest hsome ih =>
+      intro lb r h₁ h₂ h
+      simp [unionOuter, hnlt, hgt, hsome] at h
+      subst h
+      simp only [outerSortedFrom, Bool.and_eq_true] at h₁ h₂ ⊢
+      refine ⟨h₂.1, ?_⟩
+      exact ih (some c₂) rest
+        (by simp only [outerSortedFrom, Bool.and_eq_true]
+            exact ⟨⟨by simpa using hgt, h₁.1.2⟩, h₁.2⟩) h₂.2 hsome
+  | case7 c₁ i₁ xs c₂ i₂ ys hnlt hngt hnone =>
+      intro lb r h₁ h₂ h
+      simp [unionOuter, hnlt, hngt, hnone] at h
+  | case8 c₁ i₁ xs c₂ i₂ ys hnlt hngt inner hinner hnone ih =>
+      intro lb r h₁ h₂ h
+      simp [unionOuter, hnlt, hngt, hinner, hnone] at h
+  | case9 c₁ i₁ xs c₂ i₂ ys hnlt hngt inner hinner rest hrest ih =>
+      intro lb r h₁ h₂ h
+      have heq : c₁ = c₂ := bs_connex hnlt hngt
+      subst heq
+      simp only [outerSortedFrom, Bool.and_eq_true] at h₁ h₂
+      have hrests : outerSortedFrom (some c₁) rest = true :=
+        ih (some c₁) rest h₁.2 h₂.2 hrest
+      have hinns : innerSortedFrom none inner = true :=
+        unionInner_sortedFrom i₁ i₂ none inner h₁.1.2 h₂.1.2 hinner
+      cases inner with
+      | nil =>
+          simp [unionOuter, hnlt, hngt, hinner, hrest] at h
+          subst h
+          exact outerSortedFrom_weaken h₁.1.1 hrests
+      | cons a as =>
+          simp [unionOuter, hnlt, hngt, hinner, hrest] at h
+          subst h
+          simp only [outerSortedFrom, Bool.and_eq_true]
+          exact ⟨⟨h₁.1.1, hinns⟩, hrests⟩
+
+theorem unionOuter_lookup (v₁ v₂ : ValueRep) :
+    ∀ (lb : Option ByteString) (r : ValueRep) (c t : ByteString),
+      outerSortedFrom lb v₁ = true → outerSortedFrom lb v₂ = true →
+      unionOuter v₁ v₂ = some r →
+      lookupCoin c t r = lookupCoin c t v₁ + lookupCoin c t v₂ := by
+  induction v₁, v₂ using unionOuter.induct with
+  | case1 ys =>
+      intro lb r c t h₁ h₂ h
+      simp only [unionOuter, Option.some.injEq] at h
+      subst h
+      simp [lookupCoin]
+  | case2 x xs =>
+      intro lb r c t h₁ h₂ h
+      simp only [unionOuter, Option.some.injEq] at h
+      subst h
+      simp [lookupCoin]
+  | case3 c₁ i₁ xs c₂ i₂ ys hlt hnone ih =>
+      intro lb r c t h₁ h₂ h
+      simp [unionOuter, hlt, hnone] at h
+  | case4 c₁ i₁ xs c₂ i₂ ys hlt rest hsome ih =>
+      intro lb r c t h₁ h₂ h
+      simp [unionOuter, hlt, hsome] at h
+      subst h
+      simp only [outerSortedFrom, Bool.and_eq_true] at h₁ h₂
+      have ihs := ih (some c₁) rest c t h₁.2
+        (by simp only [outerSortedFrom, Bool.and_eq_true]
+            exact ⟨⟨by simpa using hlt, h₂.1.2⟩, h₂.2⟩) hsome
+      cases hbe : c₁ == c with
+      | true =>
+          have hc : c₁ = c := by simpa using hbe
+          have hne : (c₂ == c) = false :=
+            beq_false_of_ne fun he => bs_lt_ne hlt (hc.trans he.symm)
+          have hyz : lookupCoin c t ys = 0 :=
+            lookupCoin_zero_of_bound h₂.2
+              (fun hlt' => bs_lt_asymm hlt (by rwa [hc] : c₂ < c₁))
+          simp [lookupCoin, hbe, hne, hyz]
+      | false =>
+          simp [lookupCoin, hbe, ihs]
+  | case5 c₁ i₁ xs c₂ i₂ ys hnlt hgt hnone ih =>
+      intro lb r c t h₁ h₂ h
+      simp [unionOuter, hnlt, hgt, hnone] at h
+  | case6 c₁ i₁ xs c₂ i₂ ys hnlt hgt rest hsome ih =>
+      intro lb r c t h₁ h₂ h
+      simp [unionOuter, hnlt, hgt, hsome] at h
+      subst h
+      simp only [outerSortedFrom, Bool.and_eq_true] at h₁ h₂
+      have ihs := ih (some c₂) rest c t
+        (by simp only [outerSortedFrom, Bool.and_eq_true]
+            exact ⟨⟨by simpa using hgt, h₁.1.2⟩, h₁.2⟩) h₂.2 hsome
+      cases hbe : c₂ == c with
+      | true =>
+          have hc : c₂ = c := by simpa using hbe
+          have hne : (c₁ == c) = false :=
+            beq_false_of_ne fun he => bs_lt_ne hgt (hc.trans he.symm)
+          have hxz : lookupCoin c t xs = 0 :=
+            lookupCoin_zero_of_bound h₁.2
+              (fun hlt' => hnlt (by rwa [hc] : c₁ < c₂))
+          simp [lookupCoin, hbe, hne, hxz]
+      | false =>
+          simp [lookupCoin, hbe, ihs]
+  | case7 c₁ i₁ xs c₂ i₂ ys hnlt hngt hnone =>
+      intro lb r c t h₁ h₂ h
+      simp [unionOuter, hnlt, hngt, hnone] at h
+  | case8 c₁ i₁ xs c₂ i₂ ys hnlt hngt inner hinner hnone ih =>
+      intro lb r c t h₁ h₂ h
+      simp [unionOuter, hnlt, hngt, hinner, hnone] at h
+  | case9 c₁ i₁ xs c₂ i₂ ys hnlt hngt inner hinner rest hrest ih =>
+      intro lb r c t h₁ h₂ h
+      have heq : c₁ = c₂ := bs_connex hnlt hngt
+      subst heq
+      simp only [outerSortedFrom, Bool.and_eq_true] at h₁ h₂
+      have ihs := ih (some c₁) rest c t h₁.2 h₂.2 hrest
+      have hinn := unionInner_lookup i₁ i₂ none inner t h₁.1.2 h₂.1.2 hinner
+      cases hbe : c₁ == c with
+      | true =>
+          have hc : c₁ = c := by simpa using hbe
+          have hxz : lookupCoin c t xs = 0 :=
+            lookupCoin_zero_of_bound h₁.2 (by rw [← hc]; exact ByteString.lt_irrefl c₁)
+          have hyz : lookupCoin c t ys = 0 :=
+            lookupCoin_zero_of_bound h₂.2 (by rw [← hc]; exact ByteString.lt_irrefl c₁)
