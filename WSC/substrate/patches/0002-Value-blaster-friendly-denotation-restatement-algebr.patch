+              | List xs => simp [unValueDataCurrencies, h1, h2] at h
+              | I i => simp [unValueDataCurrencies, h1, h2] at h
+              | B b => simp [unValueDataCurrencies, h1, h2] at h
+      | Constr i args => simp [unValueDataCurrencies] at h
+      | Map m => simp [unValueDataCurrencies] at h
+      | List xs => simp [unValueDataCurrencies] at h
+      | I i => simp [unValueDataCurrencies] at h
