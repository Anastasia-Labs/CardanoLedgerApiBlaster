+              lookupCoin_zero_of_bound hxs (by rw [← hc]; exact ByteString.lt_irrefl c₂)
+            have hyz : lookupCoin c t ys = 0 :=
+              lookupCoin_zero_of_bound h₂.2 (by rw [← hc]; exact ByteString.lt_irrefl c₂)
+            rw [hxz, hyz] at hbad
+            simp [validQuantity_zero] at hbad
+      simpa [lookupCoin, hne] using hbad
+  | case6 c₁ i₁ xs c₂ i₂ ys hnlt hgt rest hsome ih =>
+      intro lb h₁ h₂ h
+      simp [unionOuter, hnlt, hgt, hsome] at h
+  | case7 c₁ i₁ xs c₂ i₂ ys hnlt hngt hnone =>
+      intro lb h₁ h₂ h
+      have heq : c₁ = c₂ := bs_connex hnlt hngt
+      subst heq
+      simp only [outerSortedFrom, Bool.and_eq_true] at h₁ h₂
+      obtain ⟨t, hbad⟩ := unionInner_none i₁ i₂ none h₁.1.2 h₂.1.2 hnone
+      exact ⟨c₁, t, by simpa [lookupCoin] using hbad⟩
+  | case8 c₁ i₁ xs c₂ i₂ ys hnlt hngt inner hinner hnone ih =>
+      intro lb h₁ h₂ h
+      have heq : c₁ = c₂ := bs_connex hnlt hngt
+      subst heq
+      simp only [outerSortedFrom, Bool.and_eq_true] at h₁ h₂
+      obtain ⟨c, t, hbad⟩ := ih (some c₁) h₁.2 h₂.2 hnone
+      refine ⟨c, t, ?_⟩
+      have hne : (c₁ == c) = false := by
+        cases hbe : c₁ == c with
+        | false => rfl
+        | true =>
+            have hc : c₁ = c := by simpa using hbe
+            have hxz : lookupCoin c t xs = 0 :=
