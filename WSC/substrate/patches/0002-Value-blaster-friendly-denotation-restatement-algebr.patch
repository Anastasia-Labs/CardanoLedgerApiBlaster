+/-- **Lemma group 2 (success)**: on the no-overflow branch, `lookupCoin`
+    distributes over `unionValue` as integer addition, slot by slot. -/
+theorem lookupCoin_unionValue {v₁ v₂ v : ValueRep}
+    (h₁ : valueSorted v₁ = true) (h₂ : valueSorted v₂ = true)
+    (h : unionValue v₁ v₂ = some v) (c t : ByteString) :
+    lookupCoin c t v = lookupCoin c t v₁ + lookupCoin c t v₂ :=
+  unionOuter_lookup v₁ v₂ none v c t h₁ h₂ h
+
+/-- **Lemma group 2 (failure side)**: `unionValue` fails only when some slot
+    sum leaves the signed 128-bit `Quantity` bounds. -/
+theorem unionValue_none {v₁ v₂ : ValueRep}
+    (h₁ : valueSorted v₁ = true) (h₂ : valueSorted v₂ = true)
+    (h : unionValue v₁ v₂ = none) :
+    ∃ c t, validQuantity (lookupCoin c t v₁ + lookupCoin c t v₂) = false :=
+  unionOuter_none v₁ v₂ none h₁ h₂ h
+
+/-- `unionValue` preserves sortedness (lets `lookupCoin_unionValue` chain over
+    iterated unions). -/
+theorem unionValue_sorted {v₁ v₂ v : ValueRep}
+    (h₁ : valueSorted v₁ = true) (h₂ : valueSorted v₂ = true)
+    (h : unionValue v₁ v₂ = some v) : valueSorted v = true :=
+  unionOuter_sortedFrom v₁ v₂ none v h₁ h₂ h
+
+/-! ### Lemma group 3 — pointwise characterization of `valueContains` -/
