+    · by_cases h2 : validKey tok
+      · by_cases h3 : validQuantity amt <;> simp [insertCoin, h0, h1, h2, h3]
+      · simp [insertCoin, h0, h1, h2]
+    · simp [insertCoin, h0, h1]
+
+theorem lookupInner_eq_find? (tok : ByteString) (l : List (ByteString × Integer)) :
+    lookupInner tok l =
+      (match l.find? (fun (t, _) => t == tok) with
+       | none => 0
+       | some (_, q) => q) := by
+  induction l with
+  | nil => rfl
+  | cons hd tl ih =>
+      obtain ⟨t, q⟩ := hd
+      simp only [lookupInner, List.find?]
+      cases h : t == tok <;> simp [h, ih]
+
+theorem lookupCoin_eq_find? (cur tok : ByteString) (v : ValueRep) :
+    lookupCoin cur tok v =
+      (match v.find? (fun (c, _) => c == cur) with
+       | none => 0
+       | some (_, inner) =>
+           match inner.find? (fun (t, _) => t == tok) with
+           | none => 0
+           | some (_, q) => q) := by
+  induction v with
+  | nil => rfl
+  | cons hd tl ih =>
+      obtain ⟨c, inner⟩ := hd
+      simp only [lookupCoin, List.find?]
+      cases h : c == cur <;> simp [h, ih, lookupInner_eq_find?]
+
+/-- The `Option.map`-sugar steps of the original `unionInner` hold verbatim for
+    the match-based restatement (the two are definitionally the same recursion;
+    stated for the collision-free arms, the collision arm is
+    `unionInner_collision_eq` below). -/
+theorem unionInner_lt_eq (t₁ t₂ : ByteString) (q₁ q₂ : Integer)
+    (xs ys : List (ByteString × Integer)) (h : t₁ < t₂) :
+    unionInner ((t₁, q₁) :: xs) ((t₂, q₂) :: ys) =
+      (unionInner xs ((t₂, q₂) :: ys)).map ((t₁, q₁) :: ·) := by
+  rw [unionInner]
+  simp only [if_pos h]
+  cases unionInner xs ((t₂, q₂) :: ys) <;> rfl
+
+theorem unionInner_gt_eq (t₁ t₂ : ByteString) (q₁ q₂ : Integer)
+    (xs ys : List (ByteString × Integer)) (h₁ : ¬ t₁ < t₂) (h₂ : t₂ < t₁) :
+    unionInner ((t₁, q₁) :: xs) ((t₂, q₂) :: ys) =
+      (unionInner ((t₁, q₁) :: xs) ys).map ((t₂, q₂) :: ·) := by
+  rw [unionInner]
+  simp only [if_neg h₁, if_pos h₂]
+  cases unionInner ((t₁, q₁) :: xs) ys <;> rfl
+
+theorem unionInner_collision_eq (t₁ t₂ : ByteString) (q₁ q₂ : Integer)
+    (xs ys : List (ByteString × Integer)) (h₁ : ¬ t₁ < t₂) (h₂ : ¬ t₂ < t₁) :
+    unionInner ((t₁, q₁) :: xs) ((t₂, q₂) :: ys) =
+      (if validQuantity (q₁ + q₂) then
+        (unionInner xs ys).map
+          (fun rest => if q₁ + q₂ == 0 then rest else (t₁, q₁ + q₂) :: rest)
+       else none) := by
+  rw [unionInner]
+  simp only [if_neg h₁, if_neg h₂]
+  by_cases hv : validQuantity (q₁ + q₂)
+  · simp only [hv, ite_true]
+    cases unionInner xs ys <;> rfl
+  · simp [hv]
+
+/-- The do-notation collision arm of the original `unionOuter` holds verbatim
+    for the match-based restatement. -/
+theorem unionOuter_collision_eq (c₁ c₂ : ByteString)
+    (i₁ i₂ : List (ByteString × Integer)) (xs ys : ValueRep)
+    (h₁ : ¬ c₁ < c₂) (h₂ : ¬ c₂ < c₁) :
+    unionOuter ((c₁, i₁) :: xs) ((c₂, i₂) :: ys) =
+      (do
+        let inner ← unionInner i₁ i₂
+        let rest ← unionOuter xs ys
+        pure (if inner.isEmpty then rest else (c₁, inner) :: rest)) := by
+  rw [unionOuter]
+  simp only [if_neg h₁, if_neg h₂]
+  cases unionInner i₁ i₂ with
+  | none => rfl
+  | some inner =>
+      cases unionOuter xs ys with
+      | none => rfl
+      | some rest => cases inner <;> rfl
+
+theorem containedInner_eq_all (v₁ : ValueRep) (c : ByteString)
+    (l : List (ByteString × Integer)) :
+    containedInner v₁ c l = l.all (fun (t, q) => q ≤ lookupCoin c t v₁) := by
+  induction l with
+  | nil => rfl
+  | cons hd tl ih => obtain ⟨t, q⟩ := hd; simp [containedInner, ih]
+
+theorem containedOuter_eq_all (v₁ v₂ : ValueRep) :
+    containedOuter v₁ v₂ =
+      v₂.all (fun (c, inner) => inner.all (fun (t, q) => q ≤ lookupCoin c t v₁)) := by
+  induction v₂ with
+  | nil => rfl
+  | cons hd tl ih =>
+      obtain ⟨c, inner⟩ := hd
+      simp [containedOuter, containedInner_eq_all, ih]
+
+theorem valueContains_eq_all (v₁ v₂ : ValueRep) :
+    valueContains v₁ v₂ =
+      (if hasNegativeAmount v₁ then none
+       else if hasNegativeAmount v₂ then none
+       else some (v₂.all fun (c, inner) =>
+         inner.all fun (t, q) => q ≤ lookupCoin c t v₁)) := by
+  simp [valueContains, containedOuter_eq_all]
+
+theorem innerToData_eq_map (l : List (ByteString × Integer)) :
+    innerToData l = l.map (fun (t, q) => ((.B t : Data), (.I q : Data))) := by
+  induction l with
+  | nil => rfl
+  | cons hd tl ih => obtain ⟨t, q⟩ := hd; simp [innerToData, ih]
+
+theorem valueData_eq_map (v : ValueRep) :
+    valueData v =
+      .Map (v.map fun (c, inner) =>
+        (.B c, .Map (inner.map fun (t, q) => (.B t, .I q)))) := by
+  suffices h : outerToData v =
+      v.map (fun (c, inner) =>
+        ((.B c : Data), (.Map (inner.map fun (t, q) => (.B t, .I q)) : Data))) by
+    simp [valueData, h]
+  induction v with
+  | nil => rfl
+  | cons hd tl ih =>
+      obtain ⟨c, inner⟩ := hd
+      simp [outerToData, innerToData_eq_map, ih]
+
+/-- The decode step of `unValueDataTokens` equals the original
+    negated-guard/`<$>` formulation. -/
+theorem unValueDataTokens_cons_eq (prev : Option ByteString)
+    (t : ByteString) (q : Integer) (rest : List (Data × Data)) :
+    unValueDataTokens prev ((.B t, .I q) :: rest) =
+      (if ¬ validKey t then none
+       else if ¬ ascendingFrom prev t then none
+       else if q == 0 then none
+       else if ¬ validQuantity q then none
+       else ((t, q) :: ·) <$> unValueDataTokens (some t) rest) := by
+  by_cases h1 : validKey t <;>
+    by_cases h2 : ascendingFrom prev t <;>
+      by_cases h3 : q == 0 <;>
+        by_cases h4 : validQuantity q <;>
+          simp [unValueDataTokens, h1, h2, h3, h4] <;>
+            cases unValueDataTokens (some t) rest <;> rfl
+
+/-- The decode step of `unValueDataCurrencies` equals the original
+    negated-guard/`isEmpty`/do-notation formulation. -/
+theorem unValueDataCurrencies_cons_eq (prev : Option ByteString)
+    (c : ByteString) (tsD : Data) (rest : List (Data × Data)) :
+    unValueDataCurrencies prev ((.B c, tsD) :: rest) =
+      (if ¬ validKey c then none
+       else if ¬ ascendingFrom prev c then none
+       else
+        match tsD with
+        | .Map ts =>
+            if ts.isEmpty then none
+            else do
+              let inner ← unValueDataTokens none ts
+              let restV ← unValueDataCurrencies (some c) rest
+              pure ((c, inner) :: restV)
+        | _ => none) := by
+  by_cases h1 : validKey c
+  · by_cases h2 : ascendingFrom prev c
+    · cases tsD with
+      | Constr i args => simp [unValueDataCurrencies, h1, h2]
+      | List l => simp [unValueDataCurrencies, h1, h2]
+      | I i => simp [unValueDataCurrencies, h1, h2]
+      | B b => simp [unValueDataCurrencies, h1, h2]
+      | Map ts =>
+        cases ts with
+        | nil => simp [unValueDataCurrencies, h1, h2]
+        | cons t₀ ts' =>
+            simp only [unValueDataCurrencies, h1, h2, not_true_eq_false,
+              ite_true, ite_false, if_pos, List.isEmpty_cons, Bool.false_eq_true]
+            cases unValueDataTokens none (t₀ :: ts') with
+            | none => rfl
+            | some inner =>
+                cases unValueDataCurrencies (some c) rest <;> rfl
+    · cases tsD <;> simp [unValueDataCurrencies, h1, h2]
+  · cases tsD <;> simp [unValueDataCurrencies, h1]
+
+theorem dropZeroQuantities_eq_filter (l : List (ByteString × Integer)) :
+    dropZeroQuantities l = l.filter (fun (_, q) => q != 0) := by
+  induction l with
+  | nil => rfl
+  | cons hd tl ih =>
+      obtain ⟨t, q⟩ := hd
+      rw [dropZeroQuantities, List.filter_cons, ih]
+      cases h : q == 0 <;> simp [h, bne]
+
+theorem normalizeEntries_eq_map_filter (v : ValueRep) :
+    normalizeEntries v =
+      (v.map fun (c, inner) => (c, inner.filter (fun (_, q) => q != 0))).filter
+        (fun (_, inner) => ¬ inner.isEmpty) := by
+  induction v with
+  | nil => rfl
+  | cons hd tl ih =>
+      obtain ⟨c, inner⟩ := hd
+      simp only [← dropZeroQuantities_eq_filter] at ih ⊢
+      rw [normalizeEntries]
+      cases hd : dropZeroQuantities inner with
+      | nil => simp [hd, ih]
+      | cons a l => simp [hd, ih]
+
+theorem packInnerLoop_eq_foldl (acc : List (ByteString × Integer))
+    (raw : List (ByteString × Integer)) :
+    packInnerLoop acc raw = raw.foldl (fun iacc (t, q) => innerInsert t q iacc) acc := by
+  induction raw generalizing acc with
+  | nil => rfl
+  | cons hd tl ih => obtain ⟨t, q⟩ := hd; simp [packInnerLoop, List.foldl, ih]
+
+theorem packOuterLoop_eq_foldl (acc : ValueRep)
+    (raw : List (ByteString × List (ByteString × Integer))) :
+    packOuterLoop acc raw =
+      raw.foldl
+        (fun acc (c, innerRaw) =>
+          outerInsertReplace c
+            (innerRaw.foldl (fun iacc (t, q) => innerInsert t q iacc) []) acc)
+        acc := by
+  induction raw generalizing acc with
+  | nil => rfl
+  | cons hd tl ih =>
+      obtain ⟨c, innerRaw⟩ := hd
+      simp [packOuterLoop, List.foldl, ih, packInnerLoop_eq_foldl]
+
+/-- `packValue` equals the original `foldl`/`map`/`filter` formulation. -/
+theorem packValue_eq_original (raw : List (ByteString × List (ByteString × Integer))) :
+    packValue raw =
+      (let outer := raw.foldl
+        (fun acc (c, innerRaw) =>
+          let inner := innerRaw.foldl (fun iacc (t, q) => innerInsert t q iacc) []
+          outerInsertReplace c inner acc)
+        []
+      (outer.map fun (c, inner) => (c, inner.filter (fun (_, q) => q != 0))).filter
+        (fun (_, inner) => ¬ inner.isEmpty)) := by
+  simp [packValue, normalizeEntries_eq_map_filter, packOuterLoop_eq_foldl]
 
 end PlutusCore.Value
