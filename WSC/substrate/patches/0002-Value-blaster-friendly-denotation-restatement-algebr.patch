+theorem unionOuter_none (v₁ v₂ : ValueRep) :
+    ∀ (lb : Option ByteString),
+      outerSortedFrom lb v₁ = true → outerSortedFrom lb v₂ = true →
+      unionOuter v₁ v₂ = none →
+      ∃ c t, validQuantity (lookupCoin c t v₁ + lookupCoin c t v₂) = false := by
+  induction v₁, v₂ using unionOuter.induct with
+  | case1 ys => intro lb h₁ h₂ h; simp [unionOuter] at h
+  | case2 x xs => intro lb h₁ h₂ h; simp [unionOuter] at h
+  | case3 c₁ i₁ xs c₂ i₂ ys hlt hnone ih =>
+      intro lb h₁ h₂ h
+      simp only [outerSortedFrom, Bool.and_eq_true] at h₁ h₂
+      have hys : outerSortedFrom (some c₁) ((c₂, i₂) :: ys) = true := by
+        simp only [outerSortedFrom, Bool.and_eq_true]
+        exact ⟨⟨by simpa using hlt, h₂.1.2⟩, h₂.2⟩
+      obtain ⟨c, t, hbad⟩ := ih (some c₁) h₁.2 hys hnone
+      refine ⟨c, t, ?_⟩
+      have hne : (c₁ == c) = false := by
+        cases hbe : c₁ == c with
+        | false => rfl
+        | true =>
+            have hc : c₁ = c := by simpa using hbe
+            have hxz : lookupCoin c t xs = 0 :=
+              lookupCoin_zero_of_bound h₁.2 (by rw [← hc]; exact ByteString.lt_irrefl c₁)
+            have hyz : lookupCoin c t ((c₂, i₂) :: ys) = 0 :=
+              lookupCoin_zero_of_bound hys (by rw [← hc]; exact ByteString.lt_irrefl c₁)
+            rw [hxz, hyz] at hbad
+            simp [validQuantity_zero] at hbad
+      simpa [lookupCoin, hne] using hbad
+  | case4 c₁ i₁ xs c₂ i₂ ys hlt rest hsome ih =>
+      intro lb h₁ h₂ h
+      simp [unionOuter, hlt, hsome] at h
+  | case5 c₁ i₁ xs c₂ i₂ ys hnlt hgt hnone ih =>
+      intro lb h₁ h₂ h
+      simp only [outerSortedFrom, Bool.and_eq_true] at h₁ h₂
+      have hxs : outerSortedFrom (some c₂) ((c₁, i₁) :: xs) = true := by
+        simp only [outerSortedFrom, Bool.and_eq_true]
+        exact ⟨⟨by simpa using hgt, h₁.1.2⟩, h₁.2⟩
+      obtain ⟨c, t, hbad⟩ := ih (some c₂) hxs h₂.2 hnone
+      refine ⟨c, t, ?_⟩
+      have hne : (c₂ == c) = false := by
+        cases hbe : c₂ == c with
+        | false => rfl
+        | true =>
+            have hc : c₂ = c := by simpa using hbe
