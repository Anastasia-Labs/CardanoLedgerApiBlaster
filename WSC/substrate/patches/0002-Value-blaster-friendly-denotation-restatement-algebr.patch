+theorem containedInner_correct {v₁ : ValueRep} {c : ByteString}
+    {l : List (ByteString × Integer)}
+    (hneg : hasNegativeAmount v₁ = false)
+    (h : containedInner v₁ c l = true) (t : ByteString) :
+    lookupInner t l ≤ lookupCoin c t v₁ := by
+  induction l with
+  | nil => simpa [lookupInner] using lookupCoin_nonneg (c := c) (t := t) hneg
+  | cons hd tl ih =>
+      obtain ⟨t₀, q₀⟩ := hd
+      simp only [containedInner, Bool.and_eq_true, decide_eq_true_eq] at h
+      rw [lookupInner]
+      cases hbe : t₀ == t with
+      | true =>
+          have ht : t₀ = t := by simpa using hbe
+          simpa [hbe] using ht ▸ h.1
+      | false => simpa [hbe] using ih h.2
+
+theorem containedOuter_correct {v₁ v₂ : ValueRep}
+    (hneg : hasNegativeAmount v₁ = false)
+    (h : containedOuter v₁ v₂ = true) (c t : ByteString) :
+    lookupCoin c t v₂ ≤ lookupCoin c t v₁ := by
+  induction v₂ with
+  | nil => simpa [lookupCoin] using lookupCoin_nonneg (c := c) (t := t) hneg
+  | cons hd tl ih =>
+      obtain ⟨c₀, i₀⟩ := hd
+      simp only [containedOuter, Bool.and_eq_true] at h
+      rw [lookupCoin]
+      cases hbe : c₀ == c with
+      | true =>
+          have hc : c₀ = c := by simpa using hbe
+          simpa [hbe] using containedInner_correct hneg (hc ▸ h.1) t
+      | false => simpa [hbe] using ih h.2
+
+theorem containedInner_complete {v₁ : ValueRep} {c : ByteString}
+    {l : List (ByteString × Integer)} {lb : Option ByteString}
+    (hneg : hasNegativeAmount v₁ = false)
+    (hs : innerSortedFrom lb l = true)
+    (h : ∀ t, lookupInner t l ≤ lookupCoin c t v₁) :
+    containedInner v₁ c l = true := by
+  induction l generalizing lb with
+  | nil => rfl
+  | cons hd tl ih =>
+      obtain ⟨t₀, q₀⟩ := hd
+      simp only [innerSortedFrom, Bool.and_eq_true] at hs
+      simp only [containedInner, Bool.and_eq_true, decide_eq_true_eq]
+      refine ⟨?_, ?_⟩
+      · have ht := h t₀
+        simpa [lookupInner] using ht
+      · apply ih (lb := some t₀) hs.2
+        intro t
+        have ht := h t
+        rw [lookupInner] at ht
+        cases hbe : t₀ == t with
+        | true =>
+            have heq : t₀ = t := by simpa using hbe
+            have hz : lookupInner t tl = 0 :=
+              lookupInner_zero_of_bound hs.2
+                (by rw [← heq]; exact ByteString.lt_irrefl t₀)
+            rw [hz]
+            exact lookupCoin_nonneg hneg
+        | false => simpa [hbe] using ht
+
+theorem containedOuter_complete {v₁ v₂ : ValueRep} {lb : Option ByteString}
+    (hneg : hasNegativeAmount v₁ = false)
+    (hs : outerSortedFrom lb v₂ = true)
+    (h : ∀ c t, lookupCoin c t v₂ ≤ lookupCoin c t v₁) :
+    containedOuter v₁ v₂ = true := by
+  induction v₂ generalizing lb with
+  | nil => rfl
+  | cons hd tl ih =>
+      obtain ⟨c₀, i₀⟩ := hd
+      simp only [outerSortedFrom, Bool.and_eq_true] at hs
+      simp only [containedOuter, Bool.and_eq_true]
+      refine ⟨?_, ?_⟩
+      · apply containedInner_complete hneg hs.1.2
+        intro t
+        have hc := h c₀ t
+        simpa [lookupCoin] using hc
+      · apply ih (lb := some c₀) hs.2
+        intro c t
+        have hct := h c t
+        rw [lookupCoin] at hct
+        cases hbe : c₀ == c with
+        | true =>
+            have heq : c₀ = c := by simpa using hbe
+            have hz : lookupCoin c t tl = 0 :=
+              lookupCoin_zero_of_bound hs.2
+                (by rw [← heq]; exact ByteString.lt_irrefl c₀)
+            rw [hz]
+            exact lookupCoin_nonneg hneg
+        | false => simpa [hbe] using hct
+
+/-- **Lemma group 3**: `valueContains v₁ v₂ = some true` iff neither value has
+    a negative amount and containment holds pointwise on `lookupCoin`.
+    (`v₂` sorted = key uniqueness; every builtin-produced value satisfies it.) -/
+theorem valueContains_iff {v₁ v₂ : ValueRep} (hs : valueSorted v₂ = true) :
+    valueContains v₁ v₂ = some true ↔
+      hasNegativeAmount v₁ = false ∧ hasNegativeAmount v₂ = false ∧
+      ∀ c t, lookupCoin c t v₂ ≤ lookupCoin c t v₁ := by
+  constructor
+  · intro h
+    rw [valueContains] at h
+    by_cases h1 : hasNegativeAmount v₁
+    · simp [h1] at h
+    · by_cases h2 : hasNegativeAmount v₂
+      · simp [h1, h2] at h
+      · have hco : containedOuter v₁ v₂ = true := by simpa [h1, h2] using h
+        exact ⟨by simpa using h1, by simpa using h2,
+          containedOuter_correct (by simpa using h1) hco⟩
+  · rintro ⟨h1, h2, h3⟩
+    rw [valueContains, if_neg (by simp [h1]), if_neg (by simp [h2])]
+    have := containedOuter_complete (lb := none) h1 hs h3
+    simp [this]
+
+/-- **Lemma group 3 (failure side, both arms)**: `valueContains` errors exactly
+    when either argument carries a negative amount. -/
+theorem valueContains_none_iff (v₁ v₂ : ValueRep) :
+    valueContains v₁ v₂ = none ↔
+      hasNegativeAmount v₁ = true ∨ hasNegativeAmount v₂ = true := by
+  rw [valueContains]
+  by_cases h1 : hasNegativeAmount v₁ <;> by_cases h2 : hasNegativeAmount v₂ <;>
+    simp [h1, h2]
+
+/-! ### Lemma group 4 — `unValueData` / `valueData` round trip and lookups -/
