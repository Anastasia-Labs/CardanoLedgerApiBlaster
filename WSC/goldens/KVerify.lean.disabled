-- KVerify.lean — fidelity check on the APPLIED golden flats (task X1: "verify a
-- couple of them decode before relying on them" — done for all 13).
-- Walks each applied program's Apply spine, checks every argument is a
-- `Const (Data …)` constant, and re-serialises it with PCB's CBOR encoder
-- (PlutusCore.Cbor.encodeData = the `serialiseData` builtin) printing the hex.
-- The hexes are diffed against the golden JSONs' paramsHex/scriptContextHex by
-- WSC/goldens/verify-applied.py (in this directory).
-- Run: cd <SCRATCH>/pcb-kmeasure && lake env lean KVerify.lean
--
-- BLOCKER (task N2, wsc-poc main @ 2306678): the three `programmableSeize`
-- lines are commented out — PCB @ 9f9ca8c cannot decode the post-#112 seize
-- script, which references the CIP-153 builtin `ScaleValue` (flat tag 100)
-- that PCB's `builtinTable` does not carry.  Full diagnosis and fix recipe in
-- the header of `KMeasure.lean.disabled` and in `K-MEASUREMENTS.md` §7.
-- Consequently this run verifies 10 of 13 applied flats, not 13.
import PlutusCore.UPLC.ScriptEncoding.Basic
import PlutusCore.UPLC.CekMachine
import PlutusCore.UPLC.PlutusScript
import PlutusCore.Cbor

open PlutusCore.UPLC.CekMachine
open PlutusCore.UPLC.PlutusScript (PlutusScript)
open PlutusCore.UPLC.Term (Term)
open PlutusCore.UPLC.Term (Const)
open PlutusCore.ByteString (ByteString)

namespace KVerify

def bodyOf : PlutusCore.UPLC.Term.Program → Term
  | .Program _ b => b

/-- Arguments of an `Apply` spine, in application order. -/
partial def spineArgs : Term → List Term
  | .Apply f a => spineArgs f ++ [a]
  | _ => []

partial def spineHead : Term → Term
  | .Apply f _ => spineHead f
  | t => t

def headTag : Term → String
  | .Var _ => "Var" | .Const _ => "Const" | .Builtin _ => "Builtin"
  | .Lam _ _ => "Lam" | .Apply _ _ => "Apply" | .Delay _ => "Delay"
  | .Force _ => "Force" | .Constr _ _ => "Constr" | .Case _ _ => "Case"
  | .Error => "Error"

def argHex : Term → String
  | .Const (Const.Data d) =>
      match PlutusCore.Cbor.encodeData d with
      | some s => ((repr (ByteString.mk s)).pretty).drop 1  -- Repr prints "#<hex>"
      | none   => "ENCODE-FAILED"
  | t => s!"NOT-A-DATA-CONST({headTag t})"

def verify (name : String) (ps : PlutusScript) : IO Unit := do
  let body := bodyOf ps.script
  let args := spineArgs body
  IO.println s!"### {name} head={headTag (spineHead body)} nargs={args.length}"
  for (a, i) in args.zipIdx do
    IO.println s!"ARG {name} {i} {argHex a}"

end KVerify

open KVerify

